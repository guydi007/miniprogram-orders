page { background: #f6f7f9; }
.page { min-height: 100vh; padding: 180rpx 40rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 24rpx; padding: 60rpx 40rpx; text-align: center; }
.icon { margin: auto; width: 100rpx; height: 100rpx; line-height: 100rpx; border-radius: 50%; background: #eff6ff; color: #2563eb; font-size: 64rpx; }
.title { margin-top: 30rpx; font-size: 36rpx; font-weight: bold; color: #1e293b; }
.desc { margin: 24rpx 0 40rpx; color: #64748b; font-size: 26rpx; line-height: 1.7; }
.button { background: #07c160; color: #fff; border-radius: 12rpx; }
