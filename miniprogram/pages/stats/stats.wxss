page {
  background-color: #f6f7f9;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}

/* 彻底撑满全屏、统一等宽 */
.container {
  display: block !important;
  width: 100% !important;
  padding: 24rpx !important;
  padding-bottom: 130rpx !important;
  box-sizing: border-box !important;
}

.card {
  width: 100% !important;
  box-sizing: border-box !important;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.sub-title {
  font-size: 24rpx;
  color: #888888;
}

/* 1. 顶部控制栏 */
.filter-card {
  padding: 22rpx 28rpx;
}

.period-tabs {
  display: flex;
  background: #f0f2f5;
  border-radius: 12rpx;
  padding: 6rpx;
}

.period-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 12rpx 0;
  border-radius: 8rpx;
  color: #666666;
  white-space: nowrap;
}

.period-active {
  background: #ffffff;
  color: #07c160;
  font-weight: bold;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.08);
}

/* 日期区间选择器 */
.date-range-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
}

.date-picker-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.date-label {
  font-size: 24rpx;
  color: #666666;
  flex-shrink: 0;
}

.date-val-btn {
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  white-space: nowrap;
}

.range-separator {
  font-size: 24rpx;
  color: #94a3b8;
  margin: 0 12rpx;
  flex-shrink: 0;
}

/* 师傅筛选行 */
.worker-filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 26rpx;
}

.filter-label {
  color: #666666;
}

.picker-value {
  background: #f7f8fa;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  color: #333333;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.arrow {
  font-size: 20rpx;
  color: #999999;
}

/* 2. 核心营收看板 */
.revenue-card {
  background: linear-gradient(135deg, #ffffff 0%, #f7fbf9 100%);
  border: 2rpx solid #e8f8f0;
}

.revenue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.revenue-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.period-badge {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8f0;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.revenue-main-val {
  display: flex;
  align-items: baseline;
  margin: 18rpx 0 24rpx 0;
}

.currency {
  font-size: 38rpx;
  font-weight: bold;
  color: #07c160;
  margin-right: 8rpx;
}

.amount-num {
  font-size: 64rpx;
  font-weight: bold;
  color: #07c160;
  letter-spacing: 1rpx;
  word-break: break-all;
}

/* 支付方式网格（防换行、高适配） */
.pay-method-grid {
  display: flex;
  justify-content: space-between;
  background: #ffffff;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #eef2f6;
  gap: 10rpx;
}

.pay-method-item {
  flex: 1;
  min-width: 0; /* 关键：允许内容弹性收缩 */
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #f1f5f9;
}

.pay-method-item:last-child {
  border-right: none;
}

.method-title {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.dot-wechat { background-color: #07c160; }
.dot-alipay { background-color: #1677ff; }
.dot-cash { background-color: #ff9800; }

.method-amount {
  display: flex;
  align-items: baseline;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.method-amount .cur {
  font-size: 20rpx;
  font-weight: bold;
  color: #334155;
  margin-right: 2rpx;
}

.method-amount .num {
  font-size: 26rpx;
  font-weight: bold;
  color: #1e293b;
}

/* 附属指标网格 */
.sub-metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.metric-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.m-lbl {
  font-size: 20rpx;
  color: #888888;
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.m-val {
  font-size: 24rpx;
  font-weight: bold;
  color: #333333;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.font-green { color: #07c160; }
.font-red { color: #e53935; }
.font-gray { color: #999999; }
.font-bold { font-weight: bold; }

/* 3. 师傅列表 */
.worker-stats-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.worker-card {
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #07c160;
}

.worker-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.worker-name-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rank-num {
  font-size: 20rpx;
  font-weight: bold;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #cbd5e1;
  color: #ffffff;
}

.rank-1 { background: #f59e0b; }
.rank-2 { background: #94a3b8; }
.rank-3 { background: #b45309; }

.w-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.w-total {
  font-size: 26rpx;
  color: #666666;
}

.worker-breakdown {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.worker-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #666666;
  border-top: 1rpx dashed #e2e8f0;
  padding-top: 8rpx;
}

.empty-stats {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 底部按钮 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
  z-index: 100;
}

.btn-copy-report {
  background: #07c160 !important;
  color: #ffffff !important;
  font-size: 28rpx !important;
  border-radius: 12rpx !important;
  line-height: 80rpx !important;
  height: 80rpx !important;
}