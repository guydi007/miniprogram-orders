/* ==========================================================
   城市筛选胶囊栏样式
   ========================================================== */
   .admin-city-bar {
    width: 100%;
    white-space: nowrap;
    margin-bottom: 16rpx !important;
    box-sizing: border-box;
  }
  
  .city-scroll {
    display: flex;
    width: 100%;
    box-sizing: border-box;
  }
  
  .city-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52rpx !important;
    line-height: normal !important;
    padding: 0 24rpx !important;
    margin-right: 12rpx !important;
    font-size: 26rpx !important;
    border-radius: 26rpx !important;
    background-color: #ffffff;
    color: #4b5563;
    border: 1rpx solid #e5e7eb;
    box-sizing: border-box;
    vertical-align: middle;
  }
  
  .city-chip-active {
    background-color: #07c160 !important;
    color: #ffffff !important;
    border-color: #07c160 !important;
  }
  
  /* ==========================================================
     顶部切换卡片
     ========================================================== */
  .main-tab-card {
    padding: 12rpx !important;
    background-color: #e9f8ed !important;
    margin-bottom: 20rpx !important;
  }
  .main-tabs {
    display: flex;
    justify-content: space-between;
  }
  .main-tab-item {
    flex: 1;
    text-align: center;
    font-size: 30rpx;
    font-weight: bold;
    color: #555;
    padding: 16rpx 0;
    border-radius: 12rpx;
    transition: all 0.2s;
  }
  .main-tab-item.active {
    background-color: #07c160;
    color: #fff;
    box-shadow: 0 2rpx 8rpx rgba(7, 193, 96, 0.3);
  }
  
  .filter-card {
    padding: 16rpx 28rpx !important;
  }
  .filter-tabs {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tab-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    color: #666;
    padding: 12rpx 0;
    border-radius: 8rpx;
    margin: 0 4rpx;
  }
  .tab-item.active {
    background-color: #07c160;
    color: #fff;
    font-weight: 500;
  }
  .picker-tab {
    flex: 1;
  }
  
  .picker-filter-row {
    display: flex;
    justify-content: space-between;
    margin-top: 16rpx;
    padding-top: 16rpx;
    border-top: 1rpx solid #eee;
  }
  .sub-picker {
    flex: 1;
  }
  .picker-box {
    background: #f8f9fa;
    border-radius: 8rpx;
    padding: 12rpx 16rpx;
    font-size: 26rpx;
    color: #333;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
  }
  
  /* 顶部通栏大卡片 */
  .total-revenue-box {
    background: linear-gradient(135deg, #07c160, #10ae65);
    border-radius: 12rpx;
    padding: 24rpx;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 20rpx;
  }
  .total-revenue-box .label {
    font-size: 26rpx;
    opacity: 0.9;
    margin-bottom: 8rpx;
  }
  .total-revenue-box .value {
    font-size: 48rpx;
    font-weight: bold;
  }
  
  .service-revenue-box {
    background: linear-gradient(135deg, #3b82f6, #1d4ed8) !important;
  }
  .service-sub-tip {
    font-size: 22rpx;
    opacity: 0.88;
    margin-top: 6rpx;
  }
  
  /* 2x4 网格行 */
  .four-grid-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8rpx;
  }
  
  .four-grid-row .grid-item {
    flex: 1;
    min-width: 0;
    background: #f8f9fa;
    border-radius: 10rpx;
    padding: 16rpx 4rpx;
    text-align: center;
    box-sizing: border-box;
  }
  
  .four-grid-row .sub-val {
    font-size: 26rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 6rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .four-grid-row .sub-label {
    font-size: 22rpx;
    color: #888;
    display: block;
    white-space: nowrap;
  }
  
  .four-grid-row .num {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 6rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .four-grid-row .txt {
    font-size: 22rpx;
    color: #888;
    display: block;
    white-space: nowrap;
  }
  
  .text-orange { color: #f59e0b !important; }
  .text-green { color: #07c160 !important; }
  .text-red { color: #ef4444 !important; }
  .text-blue { color: #2563eb !important; }
  
  .divider {
    height: 1rpx;
    background-color: #eee;
    margin: 20rpx 0;
  }
  
  /* 客服录单概览 */
  .service-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12rpx;
    margin-bottom: 24rpx;
  }
  .s-card {
    background: #f8f9fa;
    border-radius: 8rpx;
    padding: 16rpx 4rpx;
    text-align: center;
  }
  .s-num {
    font-size: 30rpx;
    font-weight: bold;
    color: #07c160;
    display: block;
    margin-bottom: 4rpx;
  }
  .s-txt {
    font-size: 22rpx;
    color: #666;
  }
  
  .sub-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #444;
    margin: 20rpx 0 12rpx 0;
  }
  
  /* ==========================================================
     客服表格重构（彻底解决排版错位）
     ========================================================== */
  .service-table {
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .table-header, .table-row {
    display: flex;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }
  
  .table-header {
    background-color: #f1f5f9;
    font-weight: bold;
    color: #475569;
    border-radius: 8rpx;
    padding: 14rpx 6rpx;
    font-size: 24rpx;
  }
  
  .table-row {
    padding: 16rpx 6rpx;
    border-bottom: 1rpx solid #f1f5f9;
    font-size: 24rpx;
  }
  
  .col {
    box-sizing: border-box;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  /* 5 列精准固定占比：姓名 24%、录单 15%、成单 15%、成单总额 28%、退单 18% */
  .col-name {
    width: 24%;
    text-align: left;
    padding-left: 8rpx;
    font-weight: 500;
    color: #1e293b;
  }
  .col-num {
    width: 15%;
  }
  .col-money {
    width: 28%;
    font-weight: bold;
  }
  .col-cancel {
    width: 18%;
  }
  
  /* 师傅排行榜样式 */
  .worker-item {
    display: flex;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
  }
  .worker-item:last-child {
    border-bottom: none;
  }
  .rank-badge {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    background: #e0e0e0;
    color: #fff;
    font-size: 24rpx;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16rpx;
    flex-shrink: 0;
  }
  .rank-badge.gold { background: #ffd700; color: #fff; }
  .rank-badge.silver { background: #c0c0c0; color: #fff; }
  .rank-badge.bronze { background: #cd7f32; color: #fff; }
  
  .worker-info {
    flex: 1;
    overflow: hidden;
  }
  .w-name {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 4rpx;
  }
  .w-sub {
    font-size: 24rpx;
    color: #888;
    display: block;
  }
  .worker-revenue {
    text-align: right;
    flex-shrink: 0;
  }
  .rev-val {
    font-size: 32rpx;
    font-weight: bold;
    color: #e53935;
  }
  
  .empty-tip {
    text-align: center;
    color: #999;
    font-size: 26rpx;
    padding: 30rpx 0;
  }
  
  .btn-box {
    margin-top: 30rpx;
    margin-bottom: 40rpx;
  }
  .primary-btn {
    background-color: #07c160;
    color: #fff;
    font-size: 30rpx;
    font-weight: 500;
    border-radius: 44rpx;
    height: 88rpx;
    line-height: 88rpx;
  }