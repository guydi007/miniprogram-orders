<view class="container">
  <!-- 1. 城市地区权限切换胶囊栏 -->
  <view class="admin-city-bar" wx:if="{{ userVisibleCities.length > 0 }}">
    <scroll-view scroll-x class="city-scroll" enable-flex>
      <view 
        class="city-chip {{ selectedCityFilter === 'all' ? 'city-chip-active' : '' }}" 
        bindtap="onCityFilterChange" 
        data-city="all"
        wx:if="{{ currentUser && currentUser.role === 'admin' }}"
      >
        全部城市
      </view>
      <view 
        class="city-chip {{ selectedCityFilter === item ? 'city-chip-active' : '' }}" 
        wx:for="{{ userVisibleCities }}" 
        wx:key="*this" 
        bindtap="onCityFilterChange" 
        data-city="{{ item }}"
      >
        {{ item }}
      </view>
    </scroll-view>
  </view>

  <!-- 2. 顶部大标签切换栏（财务营收 vs 客服录单） -->
  <view class="card main-tab-card">
    <view class="main-tabs">
      <view class="main-tab-item {{currentSubTab === 'revenue' ? 'active' : ''}}" bindtap="switchSubTab" data-tab="revenue">
        💰 财务营收看板
      </view>
      <view class="main-tab-item {{currentSubTab === 'service' ? 'active' : ''}}" bindtap="switchSubTab" data-tab="service">
        📞 客服录单统计
      </view>
    </view>
  </view>

  <!-- ================= 页面一：财务营收板块 ================= -->
  <block wx:if="{{currentSubTab === 'revenue'}}">
    <!-- 时间与师傅筛选 -->
    <view class="card filter-card">
      <view class="filter-tabs">
        <view class="tab-item {{revenueTimeFilterType === 'today' ? 'active' : ''}}" bindtap="onRevenueTimeChange" data-type="today">今日</view>
        <view class="tab-item {{revenueTimeFilterType === 'month' ? 'active' : ''}}" bindtap="onRevenueTimeChange" data-type="month">本月</view>
        <view class="tab-item {{revenueTimeFilterType === 'year' ? 'active' : ''}}" bindtap="onRevenueTimeChange" data-type="year">本年</view>
        <picker mode="date" value="{{revenueCustomDateValue}}" bindchange="onRevenueCustomDateChange" class="picker-tab">
          <view class="tab-item {{revenueTimeFilterType === 'custom' ? 'active' : ''}}">
            {{revenueTimeFilterType === 'custom' ? revenueCustomDateValue : '自定义'}}
          </view>
        </picker>
      </view>

      <view class="picker-filter-row">
        <picker mode="selector" range="{{workerFilterNames}}" value="{{workerFilterIndex}}" bindchange="onWorkerFilterChange" class="sub-picker">
          <view class="picker-box">👷 {{workerFilterNames[workerFilterIndex]}} ▾</view>
        </picker>
      </view>
    </view>

    <!-- 营业额与收款总览 -->
    <view class="card">
      <view class="section-title">💰 营业额与收款总览</view>
      
      <!-- 顶部通栏大卡片：实收营业总额（纯现金到账） -->
      <view class="total-revenue-box">
        <text class="label">实收营业总额 (元)</text>
        <text class="value">¥{{statsData.totalRevenue}}</text>
      </view>
      
      <!-- 第 1 行（4项网格）：微信支付 ｜ 支付宝 ｜ 现金收款 ｜ 待收尾款 -->
      <view class="four-grid-row">
        <view class="grid-item">
          <text class="sub-val">¥{{statsData.wechatRevenue}}</text>
          <text class="sub-label">微信支付</text>
        </view>
        <view class="grid-item">
          <text class="sub-val">¥{{statsData.alipayRevenue}}</text>
          <text class="sub-label">支付宝</text>
        </view>
        <view class="grid-item">
          <text class="sub-val">¥{{statsData.cashRevenue}}</text>
          <text class="sub-label">现金收款</text>
        </view>
        <view class="grid-item">
          <text class="sub-val text-orange">¥{{statsData.pendingBalance}}</text>
          <text class="sub-label">待收尾款</text>
        </view>
      </view>

      <!-- 分割线 -->
      <view class="divider"></view>

      <!-- 第 2 行（4 项横排）：完工单数 ｜ 现场未成 ｜ 待成单数 ｜ 平均客单价 -->
      <view class="four-grid-row">
        <view class="grid-item">
          <text class="num text-green">{{statsData.completedCount}}</text>
          <text class="txt">完工单数</text>
        </view>
        <view class="grid-item">
          <text class="num text-red">{{statsData.uncompletedCount}}</text>
          <text class="txt">现场未成</text>
        </view>
        <view class="grid-item">
          <text class="num text-blue">{{statsData.pendingSettleCount}}</text>
          <text class="txt">待成单数</text>
        </view>
        <view class="grid-item">
          <text class="num">¥{{statsData.avgOrderPrice}}</text>
          <text class="txt">平均客单价</text>
        </view>
      </view>
    </view>

    <!-- 师傅业绩贡献榜 -->
    <view class="card">
      <view class="section-title">👷 师傅业绩贡献榜</view>
      <block wx:if="{{workerRankList.length > 0}}">
        <view class="worker-item" wx:for="{{workerRankList}}" wx:key="key">
          <view class="rank-badge {{index === 0 ? 'gold' : (index === 1 ? 'silver' : (index === 2 ? 'bronze' : ''))}}">{{index + 1}}</view>
          <view class="worker-info">
            <text class="w-name">{{item.displayName || item.name}}</text>
            <text class="w-sub">完工: {{item.completed}}单 | 未成: {{item.uncompleted}}单 | 待成: {{item.pendingCount}}单 | 待收: ¥{{item.pending}}</text>
          </view>
          <view class="worker-revenue">
            <text class="rev-val">¥{{item.revenue}}</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-tip">暂无匹配的师傅结算数据</view>
      </block>
    </view>
  </block>

  <!-- ================= 页面二：客服录单板块 ================= -->
  <block wx:if="{{currentSubTab === 'service'}}">
    <!-- 时间与录单人筛选 -->
    <view class="card filter-card">
      <view class="filter-tabs">
        <view class="tab-item {{serviceTimeFilterType === 'today' ? 'active' : ''}}" bindtap="onServiceTimeChange" data-type="today">今日</view>
        <view class="tab-item {{serviceTimeFilterType === 'month' ? 'active' : ''}}" bindtap="onServiceTimeChange" data-type="month">本月</view>
        <view class="tab-item {{serviceTimeFilterType === 'year' ? 'active' : ''}}" bindtap="onServiceTimeChange" data-type="year">本年</view>
        <picker mode="date" value="{{serviceCustomDateValue}}" bindchange="onServiceCustomDateChange" class="picker-tab">
          <view class="tab-item {{serviceTimeFilterType === 'custom' ? 'active' : ''}}">
            {{serviceTimeFilterType === 'custom' ? serviceCustomDateValue : '自定义'}}
          </view>
        </picker>
      </view>

      <view class="picker-filter-row">
        <picker mode="selector" range="{{creatorFilterNames}}" value="{{creatorFilterIndex}}" bindchange="onCreatorFilterChange" class="sub-picker">
          <view class="picker-box">📞 {{creatorFilterNames[creatorFilterIndex]}} ▾</view>
        </picker>
      </view>
    </view>

    <!-- 客服录单统计看板 -->
    <view class="card">
      <view class="section-title">📞 客服签单与录单战报</view>

      <!-- 客服成单总额大卡片 -->
      <view class="total-revenue-box service-revenue-box">
        <text class="label">客服锁定签约总额 (元)</text>
        <text class="value">¥{{serviceStatsSummary.totalRevenueCreated}}</text>
        <text class="service-sub-tip">已收定金: ¥{{serviceStatsSummary.collectedDeposit}} | 待收尾款: ¥{{serviceStatsSummary.pendingTail}}</text>
      </view>

      <view class="service-summary-grid">
        <view class="s-card">
          <text class="s-num">{{serviceStatsSummary.totalCreated}}</text>
          <text class="s-txt">录单数</text>
        </view>
        <view class="s-card">
          <text class="s-num">{{serviceStatsSummary.completedCreated}}</text>
          <text class="s-txt">有效成单</text>
        </view>
        <view class="s-card">
          <text class="s-num text-red">{{serviceStatsSummary.cancelledCreated}}</text>
          <text class="s-txt">客服退单</text>
        </view>
        <view class="s-card">
          <text class="s-num text-orange">{{serviceStatsSummary.workerFailCreated}}</text>
          <text class="s-txt">现场未成</text>
        </view>
        <view class="s-card">
          <text class="s-num">{{serviceStatsSummary.sameDayAppoint}}</text>
          <text class="s-txt">当天约</text>
        </view>
        <view class="s-card">
          <text class="s-num">{{serviceStatsSummary.nextDayAppoint}}</text>
          <text class="s-txt">次日约</text>
        </view>
      </view>

      <!-- 客服明细列表：固定百分比网格 -->
      <block wx:if="{{serviceRankList.length > 0}}">
        <view class="sub-title">客服业绩明细排行</view>
        <view class="service-table">
          <view class="table-header">
            <text class="col col-name">客服</text>
            <text class="col col-num">录单</text>
            <text class="col col-num">成单</text>
            <text class="col col-money">成单总额</text>
            <text class="col col-cancel">退单</text>
          </view>
          <view class="table-row" wx:for="{{serviceRankList}}" wx:key="key">
            <text class="col col-name">{{item.displayName || item.name}}</text>
            <text class="col col-num">{{item.total}}</text>
            <text class="col col-num text-green">{{item.completed}}</text>
            <text class="col col-money text-orange">¥{{item.revenue}}</text>
            <text class="col col-cancel text-red">{{item.cancelled}}</text>
          </view>
        </view>
      </block>
    </view>
  </block>

  <!-- 底部一键复制对应日报按钮 -->
  <view class="btn-box">
    <button class="primary-btn" bindtap="copyReport">
      📋 一键复制{{currentSubTab === 'revenue' ? '财务营收' : '客服录单'}}日报
    </button>
  </view>
</view>