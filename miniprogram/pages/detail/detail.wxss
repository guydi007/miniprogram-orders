page {
  background-color: #f6f7f9;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.detail-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.status-badge-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.city-tag {
  font-size: 26rpx;
  background: #eff6ff;
  color: #2563eb;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
}

.status-pending { background: #fff3e0; color: #ff9800; }
.status-assigned { background: #e3f2fd; color: #2196f3; }
.status-done { background: #e8f8f0; color: #07c160; }
.status-fail { background: #ffebee; color: #e53935; }

.urgent-banner {
  background: #fef2f2;
  color: #ef4444;
  font-size: 26rpx;
  font-weight: bold;
  padding: 14rpx;
  border-radius: 10rpx;
  margin-top: 18rpx;
  text-align: center;
}

.amount-banner {
  background: #ecfdf5;
  color: #059669;
  padding: 18rpx;
  border-radius: 12rpx;
  margin-top: 18rpx;
}

.prepay-banner {
  background: #eff6ff;
  color: #2563eb;
}

.banner-title {
  font-size: 30rpx;
  font-weight: bold;
}

.banner-sub {
  font-size: 26rpx;
  margin-top: 6rpx;
}

.banner-split {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.bold-text {
  font-weight: bold;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #334155;
  border-bottom: 1rpx solid #f1f5f9;
  padding-bottom: 14rpx;
  margin-bottom: 18rpx;
}

.info-row {
  display: flex;
  margin-bottom: 14rpx;
  font-size: 26rpx;
}

.info-label {
  color: #64748b;
  width: 160rpx;
  flex-shrink: 0;
}

.info-val {
  color: #1e293b;
  flex: 1;
}

.phone { color: #0284c7; font-weight: 500; }
.address-value { min-width: 0; }
.address-link {
  display: block;
  color: #0284c7;
  font-size: 26rpx;
  line-height: 1.6;
  overflow-wrap: break-word;
}
.address-map-hint {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.6;
  padding-top: 6rpx;
}
.highlight { color: #07c160; font-weight: 500; }

.time-row-val {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

/* 精致居中改期胶囊 */
.btn-edit-time {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  background: #f0f7ff;
  border: 1rpx solid #d0e7ff;
  box-sizing: border-box;
  flex-shrink: 0;
}

.btn-edit-time:active {
  background: #dbeafe;
}

.edit-icon {
  font-size: 20rpx;
  line-height: 1;
  margin-right: 6rpx;
  display: flex;
  align-items: center;
}

.edit-text {
  font-size: 22rpx;
  color: #0284c7;
  font-weight: 500;
  line-height: 1;
}

.time-logs-box {
  background: #f8fafc;
  border: 1rpx dashed #cbd5e1;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  margin: 6rpx 0 16rpx 0;
}

.time-log-item {
  font-size: 22rpx;
  color: #475569;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.time-log-item:last-child {
  margin-bottom: 0;
}

.time-log-tag {
  background: #e2e8f0;
  color: #334155;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
}

.time-log-desc {
  color: #0284c7;
  font-weight: 500;
}

.time-log-meta {
  color: #94a3b8;
}

.cancel-row {
  background: #fef2f2;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
}

.font-red { color: #dc2626 !important; }

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.finish-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
}

.finish-note {
  font-size: 24rpx;
  color: #475569;
  margin-top: 16rpx;
  background: #f8fafc;
  padding: 14rpx;
  border-radius: 8rpx;
}

.log-timeline {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.log-item {
  background: #f8fafc;
  border: 1rpx solid #eef2f6;
  border-radius: 12rpx;
  padding: 18rpx;
}

.feedback-log-item {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.feedback-text {
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.5;
}

.log-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #94a3b8;
  border-bottom: 1rpx dashed #e2e8f0;
  padding-bottom: 8rpx;
  margin-bottom: 10rpx;
}

.log-body {
  font-size: 24rpx;
  color: #334155;
}

.log-type-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-bottom: 8rpx;
}

.tag-full { background: #e8f8f0; color: #07c160; font-weight: 500; }
.tag-prepay { background: #eff6ff; color: #2563eb; font-weight: 500; }

.log-strong {
  font-weight: bold;
  color: #e53935;
  font-size: 26rpx;
  margin-right: 10rpx;
}

.log-sub {
  font-size: 22rpx;
  color: #64748b;
}

.log-companion {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #475569;
}

.log-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  background: #ffffff;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
}

.log-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.log-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
}

.actions-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.picker-btn-wrapper {
  flex: 1;
  min-width: 150rpx;
}

.btn-action {
  flex: 1;
  min-width: 140rpx;
  font-size: 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 12rpx;
  font-weight: 500;
  padding: 0 !important;
}

.btn-urgent { background: #fee2e2; color: #dc2626; }
.btn-assign { background: #0284c7; color: #ffffff; width: 100% !important; }
.btn-feedback { background: #e0f2fe; color: #0284c7; }
.btn-cancel { background: #fee2e2; color: #dc2626; border: 1rpx solid #fca5a5; }
.btn-fail { background: #f1f5f9; color: #64748b; }
.btn-prepay { background: #eff6ff; color: #2563eb; }
.btn-done { background: #07c160; color: #ffffff; }

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-box {
  background: #ffffff;
  width: 90%;
  max-height: 88vh;
  overflow-y: auto;
  border-radius: 20rpx;
  padding: 34rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  color: #1e293b;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.cancel-tips {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.quick-time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-pill {
  background: #f1f5f9;
  font-size: 24rpx;
  color: #475569;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.split-pay-grid {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.split-item {
  flex: 1;
}

.split-label {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-bottom: 6rpx;
  text-align: center;
}

.split-input {
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  height: 72rpx;
  border-radius: 8rpx;
  padding: 0 10rpx;
  font-size: 26rpx;
  text-align: center;
  box-sizing: border-box;
}

.calc-total-box {
  background: #f0fdf4;
  border: 1rpx dashed #86efac;
  padding: 16rpx;
  border-radius: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.calc-total-box.prepay-box {
  background: #f0f9ff;
  border-color: #bae6fd;
}

.calc-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #334155;
}

.calc-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #15803d;
}

.prepay-box .calc-num {
  color: #0369a1;
}

.calc-remain-box {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 12rpx;
}

.remain-num {
  font-size: 30rpx;
  color: #e53935;
  font-weight: bold;
}

.field-label {
  font-size: 26rpx;
  color: #475569;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.required::after {
  content: " *";
  color: #e53935;
}

.modal-input {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  height: 76rpx;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.modal-textarea {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  height: 140rpx;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  width: 100%;
}

.upload-photo-box {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.thumb-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.del-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 20rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
}

.add-photo-btn {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #94a3b8;
}

.plus { font-size: 36rpx; line-height: 1; }
.tip { font-size: 20rpx; margin-top: 4rpx; }

.modal-btns { display: flex; gap: 16rpx; }
.modal-btn { flex: 1; font-size: 28rpx; border-radius: 10rpx; }
.modal-btn.cancel { background: #f1f5f9; color: #64748b; }
.modal-btn.confirm { background: #07c160; color: #ffffff; }
.modal-btn.btn-danger { background: #dc2626; color: #ffffff; }

.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
