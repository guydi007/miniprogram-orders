<view class="container" wx:if="{{ order }}">
  <!-- 1. 工单头部状态与金额总览 -->
  <view class="detail-card header-card">
    <view class="status-badge-row">
      <text class="city-tag">{{ order.city || '未标记城市' }}</text>
      <text class="status-tag {{ order.status === '待派单' ? 'status-pending' : (order.status === '已派单' ? 'status-assigned' : (order.status === '未成单' ? 'status-fail' : 'status-done')) }}">{{ order.status }}</text>
    </view>
    <view class="urgent-banner" wx:if="{{ order.isUrgent }}">🚨 客户已催单！请优先处理</view>
    
    <!-- 预付款模式总览 -->
    <view class="amount-banner prepay-banner" wx:if="{{ order.settleType === '预付款' }}">
      <view class="banner-title">📑 工程总计：¥{{ order.totalAmount || 0 }}</view>
      <view class="banner-sub">
        已收定金合计：<text class="bold-text">¥{{ order.depositAmount || order.finalAmount || 0 }}</text>（待收尾款：¥{{ order.remainingAmount || 0 }}）
      </view>
      <view class="banner-split" wx:if="{{ order.wechatAmount || order.alipayAmount || order.cashAmount }}">
        渠道明细：微信 ¥{{ order.wechatAmount || 0 }} | 支付宝 ¥{{ order.alipayAmount || 0 }} | 现金 ¥{{ order.cashAmount || 0 }}
      </view>
    </view>

    <!-- 全款完工模式总览 -->
    <view class="amount-banner" wx:elif="{{ order.status === '已完工' && (order.finalAmount || order.totalAmount) }}">
      <view class="banner-title">💰 实收合计金额：¥{{ order.finalAmount || 0 }}</view>
      <view class="banner-split" wx:if="{{ order.wechatAmount || order.alipayAmount || order.cashAmount }}">
        渠道明细：微信 ¥{{ order.wechatAmount || 0 }} | 支付宝 ¥{{ order.alipayAmount || 0 }} | 现金 ¥{{ order.cashAmount || 0 }}
      </view>
    </view>
  </view>

  <!-- 2. 工单基础信息 -->
  <view class="detail-card">
    <view class="section-title">📋 基础信息</view>
    <view class="info-row">
      <text class="info-label">客户电话：</text>
      <text class="info-val phone" bindtap="callCustomer">{{ order.customerPhone }} 📞</text>
    </view>
    <view class="info-row">
      <text class="info-label">服务地址：</text>
      <view class="info-val address-value">
        <text class="address-link" wx:if="{{ order.address }}" bindtap="openOrderLocation">📍 {{ order.address }}</text>
        <text wx:else>-</text>
        <text class="address-map-hint" wx:if="{{ order.address }}" bindtap="openOrderLocation">点击查看地图 ›</text>
      </view>
    </view>

    <!-- 预约时间 -->
    <view class="info-row">
      <text class="info-label">预约时间：</text>
      <view class="time-row-val">
        <text class="info-val highlight">{{ order.appointmentTime }}</text>
        <view 
          class="btn-edit-time" 
          wx:if="{{ canEditAppointment }}"
          bindtap="openEditTimeModal"
        >
          <text class="edit-icon">✏️</text>
          <text class="edit-text">改期</text>
        </view>
      </view>
    </view>

    <!-- 预约时间改期留痕展示 -->
    <view class="time-logs-box" wx:if="{{ order.appointmentLogs && order.appointmentLogs.length }}">
      <view class="time-log-item" wx:for="{{ order.appointmentLogs }}" wx:key="id">
        <text class="time-log-tag">改期</text>
        <text class="time-log-desc">{{ item.oldTime }} ➔ {{ item.newTime }}</text>
        <text class="time-log-meta">({{ item.operatorName }} {{ item.timeFormatted }})</text>
      </view>
    </view>

    <view class="info-row">
      <text class="info-label">主派师傅：</text>
      <text class="info-val highlight">{{ order.workerName || '未指派' }}</text>
    </view>
    <view class="info-row" wx:if="{{ order.companionWorkers }}">
      <text class="info-label">同行人员：</text>
      <text class="info-val">{{ order.companionWorkers }}</text>
    </view>
    <view class="info-row" wx:if="{{ order.source }}">
      <text class="info-label">订单来源：</text>
      <text class="info-val">{{ order.source }}</text>
    </view>
    <view class="info-row" wx:if="{{ order.creatorName }}">
      <text class="info-label">录单人：</text>
      <text class="info-val">{{ order.creatorName }}</text>
    </view>
    <view class="info-row" wx:if="{{ order.finishTime }}">
      <text class="info-label">{{ order.settleType === '预付款' ? '最新收款时间：' : '结算时间：' }}</text>
      <text class="info-val">{{ order.finishTimeFormatted || order.finishTime }}</text>
    </view>
    
    <!-- 取消原因展示（客服退单） -->
    <view class="info-row cancel-row" wx:if="{{ order.cancelReason }}">
      <text class="info-label font-red">退单取消：</text>
      <text class="info-val font-red">{{ order.cancelReason }}（{{ order.cancelOperator || '客服' }} {{ order.cancelTimeFormatted || '' }}）</text>
    </view>

    <!-- 师傅现场未成单原因展示 -->
    <view class="info-row cancel-row" wx:if="{{ order.failReason }}">
      <text class="info-label font-red">现场未成：</text>
      <text class="info-val font-red">{{ order.failReason }}（{{ order.failOperator || '师傅' }} {{ order.failTimeFormatted || '' }}）</text>
    </view>
  </view>

  <!-- 3. 最新施工凭据照片 -->
  <view class="detail-card" wx:if="{{ order.finishPhotos && order.finishPhotos.length }}">
    <view class="section-title">📸 最新完工凭据照片</view>
    <view class="photo-grid">
      <image 
        class="finish-img" 
        wx:for="{{ order.finishPhotos }}" 
        wx:key="*this" 
        src="{{ item }}" 
        mode="aspectFill" 
        bindtap="previewPhoto" 
        data-url="{{ item }}" 
        data-list="{{ order.finishPhotos }}" 
      />
    </view>
    <view class="finish-note" wx:if="{{ order.finishNote }}">
      <text class="note-label">施工说明：</text>{{ order.finishNote }}
    </view>
  </view>

  <!-- 4. 操作按钮栏 -->
  <view class="actions-bar">
    <!-- 客服与主管可见：催单 -->
    <button 
      class="btn-action btn-urgent" 
      wx:if="{{ (currentUser.role === 'service' || currentUser.role === 'leader') && order.status !== '已完工' && order.status !== '未成单' }}" 
      bindtap="triggerUrgent"
    >
      🚨 催单
    </button>

    <!-- 单独派单/改派：仅限主管操作 -->
    <picker 
      wx:if="{{ currentUser && isLeader && order.status !== '已完工' && order.status !== '未成单' }}" 
      bindchange="onAssignWorker" 
      range="{{ candidateWorkerNames }}"
      class="picker-btn-wrapper"
    >
      <button class="btn-action btn-assign">
        {{ order.workerName ? '改派师傅' : '指派师傅' }}
      </button>
    </picker>

    <!-- 进度回馈按钮：非未成单均可提交 -->
    <button 
      class="btn-action btn-feedback" 
      wx:if="{{ currentUser && (currentUser.role === 'service' || currentUser.role === 'leader' || currentUser.role === 'worker') && order.status !== '未成单' }}" 
      bindtap="openFeedbackModal"
    >
      💬 回馈
    </button>

    <!-- 仅客服专属：取消工单（主管无此按钮） -->
    <button 
      class="btn-action btn-cancel" 
      wx:if="{{ currentUser && currentUser.role === 'service' && order.status !== '已完工' && order.status !== '未成单' }}" 
      bindtap="openCancelModal"
    >
      ❌ 取消工单
    </button>

    <!-- 现场未成单：仅负责该单的师傅或主管可操作 -->
    <button 
      class="btn-action btn-fail" 
      wx:if="{{ canOperateSettle && order.status !== '未成单' && order.status !== '已完工' }}" 
      bindtap="openFailModal"
    >
      未成单
    </button>

    <!-- 预付单：仅负责该单的师傅或主管可操作 -->
    <button 
      class="btn-action btn-prepay" 
      wx:if="{{ canOperateSettle && order.status !== '未成单' && (!order.settleType || order.settleType === '预付款') }}" 
      bindtap="openPrepayModal"
    >
      {{ order.settleType === '预付款' ? (order.remainingAmount > 0 ? '续收/结清尾款' : '修改预付单') : '预付单' }}
    </button>

    <!-- 全款结单：仅负责该单的师傅或主管可操作 -->
    <button 
      class="btn-action btn-done" 
      wx:if="{{ canOperateSettle && order.status !== '未成单' && (!order.settleType || order.settleType === '全款') }}" 
      bindtap="openFinishModal"
    >
      {{ order.settleType === '全款' ? '修改全款结算' : '全款结单' }}
    </button>
  </view>

  <!-- 5. 施工与进度回馈记录流 -->
  <view class="detail-card" wx:if="{{ order.feedbacks && order.feedbacks.length }}">
    <view class="section-title">💬 施工与进度回馈 ({{ order.feedbacks.length }})</view>
    <view class="log-timeline">
      <view class="log-item feedback-log-item" wx:for="{{ order.feedbacks }}" wx:key="id">
        <view class="log-header">
          <view class="log-time">{{ item.timeFormatted || item.time }}</view>
          <view class="log-operator">{{ item.operatorName }} ({{ item.operatorRole === 'worker' ? '师傅' : (item.operatorRole === 'leader' ? '主管' : (item.operatorRole === 'service' ? '客服' : '管理')) }})</view>
        </view>
        <view class="log-body">
          <view class="feedback-text">{{ item.content }}</view>
          <view class="log-photos" wx:if="{{ item.photos && item.photos.length }}">
            <image 
              class="log-thumb" 
              wx:for="{{ item.photos }}" 
              wx:for-item="p" 
              wx:key="*this" 
              src="{{ p }}" 
              mode="aspectFill" 
              bindtap="previewPhoto" 
              data-url="{{ p }}" 
              data-list="{{ item.photos }}" 
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 6. 支付与修改历史记录流水 -->
  <view class="detail-card" wx:if="{{ order.paymentLogs && order.paymentLogs.length }}">
    <view class="section-title">📜 支付与修改记录 ({{ order.paymentLogs.length }})</view>
    <view class="log-timeline">
      <view class="log-item" wx:for="{{ order.paymentLogs }}" wx:key="id">
        <view class="log-header">
          <view class="log-time">{{ item.timeFormatted || item.time }}</view>
          <view class="log-operator">{{ item.operatorName }} ({{ item.operatorRole === 'worker' ? '师傅' : (item.operatorRole === 'leader' ? '主管' : (item.operatorRole === 'service' ? '客服' : '管理')) }})</view>
        </view>
        
        <view class="log-body">
          <view class="log-type-tag {{ item.settleType === '全款' ? 'tag-full' : 'tag-prepay' }}">
            {{ item.settleType }}记录
          </view>
          
          <view class="log-amount-row">
            <text class="log-strong">{{ item.operationLabel }}：{{ item.isCorrection ? '累计实收' : '本次收款' }} ¥{{ item.isCorrection ? item.paidAfter : item.amountThisTime }}</text>
            <text class="log-sub" wx:if="{{ !item.isCorrection }}">（累计实收:¥{{ item.paidAfter }}）</text>
          </view>
          <view class="log-amount-row">
            <text class="log-sub">渠道累计：现金 {{ item.cashAmount || 0 }} / 微信 {{ item.wechatAmount || 0 }} / 支付宝 {{ item.alipayAmount || 0 }}</text>
          </view>
          <view class="log-amount-row" wx:if="{{ item.settleType === '预付款' }}">
            <text class="log-sub">工程总计:¥{{ item.totalAmount }} / 待收尾款:¥{{ item.remainingAmount }}</text>
          </view>

          <view class="log-companion" wx:if="{{ item.companionWorkers }}">
            👥 同行人员：{{ item.companionWorkers }}
          </view>

          <view class="log-note" wx:if="{{ item.note }}">
            📝 备注：{{ item.note }}
          </view>

          <view class="log-photos" wx:if="{{ item.photos && item.photos.length }}">
            <image 
              class="log-thumb" 
              wx:for="{{ item.photos }}" 
              wx:for-item="p" 
              wx:key="*this" 
              src="{{ p }}" 
              mode="aspectFill" 
              bindtap="previewPhoto" 
              data-url="{{ p }}" 
              data-list="{{ item.photos }}" 
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 7. 弹窗：修改预约时间 -->
  <view class="modal-mask" wx:if="{{ showEditTimeModal }}">
    <view class="modal-box">
      <view class="modal-title">📅 修改预约上门时间</view>
      
      <view class="field-item">
        <text class="field-label required">预约时间：</text>
        <input 
          class="modal-input" 
          placeholder="如：2026-09-03 上午" 
          value="{{ editTimeInput }}" 
          bindinput="onEditTimeInput" 
          bindblur="onEditTimeBlur" 
        />
      </view>

      <view class="quick-time-grid mt-20">
        <view class="quick-pill" bindtap="onQuickEditTime" data-val="今天 上午">今天 上午</view>
        <view class="quick-pill" bindtap="onQuickEditTime" data-val="今天 下午">今天 下午</view>
        <view class="quick-pill" bindtap="onQuickEditTime" data-val="明天 上午">明天 上午</view>
        <view class="quick-pill" bindtap="onQuickEditTime" data-val="明天 下午">明天 下午</view>
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeEditTimeModal">取消</button>
        <button class="modal-btn confirm" bindtap="submitEditTime">保存改期</button>
      </view>
    </view>
  </view>

  <!-- 8. 弹窗：取消工单（客服退单专用） -->
  <view class="modal-mask" wx:if="{{ showCancelModal }}">
    <view class="modal-box">
      <view class="modal-title font-red">❌ 客服取消工单确认</view>
      <view class="cancel-tips">取消后将记为【客服退单】归档，不影响师傅现场业绩，请填写退单理由：</view>
      
      <view class="field-item mt-10">
        <text class="field-label required">退单理由：</text>
        <textarea 
          class="modal-textarea" 
          placeholder="如：客户临时不需要维修、重复下单、电话无法接通等..." 
          value="{{ cancelReason }}" 
          bindinput="onCancelReasonInput" 
        />
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeCancelModal">再想想</button>
        <button class="modal-btn btn-danger" bindtap="submitCancelOrder">确认取消</button>
      </view>
    </view>
  </view>

  <!-- 9. 弹窗：进度回馈录入 -->
  <view class="modal-mask" wx:if="{{ showFeedbackModal }}">
    <view class="modal-box">
      <view class="modal-title">💬 提交施工与进度回馈</view>
      
      <view class="field-item">
        <text class="field-label required">回馈内容说明：</text>
        <textarea 
          class="modal-textarea" 
          placeholder="如：已上门排查，主板受潮需更换配件；或客户改约明日等..." 
          value="{{ feedbackContent }}" 
          bindinput="onFeedbackContentInput" 
        />
      </view>

      <view class="field-item mt-20">
        <text class="field-label">现场照片（选填，支持多张）：</text>
        <view class="upload-photo-box">
          <view class="photo-thumb" wx:for="{{ feedbackPhotos }}" wx:key="*this">
            <image class="thumb-img" src="{{ item }}" mode="aspectFill" />
            <text class="del-btn" bindtap="deleteFeedbackPhoto" data-index="{{ index }}">✕</text>
          </view>
          <view class="add-photo-btn" bindtap="chooseFeedbackPhoto" wx:if="{{ feedbackPhotos.length < 4 }}">
            <text class="plus">+</text>
            <text class="tip">拍现场</text>
          </view>
        </view>
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeFeedbackModal">取消</button>
        <button class="modal-btn confirm" bindtap="submitFeedback">提交回馈</button>
      </view>
    </view>
  </view>

  <!-- 10. 弹窗：全款结单录入/修改 -->
  <view class="modal-mask" wx:if="{{ showFinishModal && settleMode === 'full' }}">
    <view class="modal-box">
      <view class="modal-title">🎉 全款完工结单录入/修改</view>
      <view class="cancel-tips" wx:if="{{ paymentRetryLocked }}">上次付款结果待确认：当前表单已锁定，只能使用原内容和原流水号重试。</view>

      <view class="split-pay-grid">
        <view class="split-item">
          <text class="split-label">现金 (元)</text>
          <input class="split-input" type="digit" placeholder="0" value="{{ inputCash }}" disabled="{{ paymentRetryLocked }}" bindinput="onCashInput" />
        </view>
        <view class="split-item">
          <text class="split-label">微信 (元)</text>
          <input class="split-input" type="digit" placeholder="0" value="{{ inputWechat }}" disabled="{{ paymentRetryLocked }}" bindinput="onWechatInput" />
        </view>
        <view class="split-item">
          <text class="split-label">支付宝 (元)</text>
          <input class="split-input" type="digit" placeholder="0" value="{{ inputAlipay }}" disabled="{{ paymentRetryLocked }}" bindinput="onAlipayInput" />
        </view>
      </view>

      <view class="calc-total-box">
        <text class="calc-title">实收合计金额：</text>
        <text class="calc-num">¥{{ fullTotal }}</text>
      </view>

      <view class="field-item mt-20">
        <text class="field-label">同行人员（手输文本）：</text>
        <input class="modal-input" placeholder="如：学徒小张、王师傅（无则留空）" value="{{ modalCompanions }}" disabled="{{ paymentRetryLocked }}" bindinput="onModalCompanionsInput" />
      </view>

      <view class="field-item mt-20">
        <text class="field-label">本次施工拍照留痕（可多次补拍）：</text>
        <view class="cancel-tips" wx:if="{{ pendingPaymentCloudIds.length }}">上次网络异常时已上传的凭据已保留，重试时会继续使用，不会重复上传。</view>
        <view class="upload-photo-box">
          <view class="photo-thumb" wx:for="{{ pendingPaymentCloudIds }}" wx:key="*this">
            <image class="thumb-img" src="{{ item }}" mode="aspectFill" bindtap="previewPhoto" data-url="{{ item }}" data-list="{{ pendingPaymentCloudIds }}" />
          </view>
          <view class="photo-thumb" wx:for="{{ localPhotos }}" wx:key="*this">
            <image class="thumb-img" src="{{ item }}" mode="aspectFill" />
            <text class="del-btn" bindtap="deletePhoto" data-index="{{ index }}">✕</text>
          </view>
          <view class="add-photo-btn" bindtap="chooseFinishPhoto" wx:if="{{ localPhotos.length + pendingPaymentCloudIds.length < 4 }}">
            <text class="plus">+</text>
            <text class="tip">拍现场</text>
          </view>
        </view>
      </view>

      <view class="field-item mt-20">
        <view wx:if="{{ order.settleType }}">
          <text class="field-label required">金额修正原因：</text>
          <textarea class="modal-textarea" placeholder="修改金额或支付渠道时必填" value="{{ correctionReason }}" disabled="{{ paymentRetryLocked }}" bindinput="onCorrectionReasonInput" />
        </view>
        <text class="field-label">施工/修改备注说明：</text>
        <textarea class="modal-textarea" placeholder="更换明细、费用调整原因等..." value="{{ modalNote }}" disabled="{{ paymentRetryLocked }}" bindinput="onModalNoteInput" />
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeFinishModal">取消</button>
        <button class="modal-btn confirm" bindtap="submitFinishOrder">确认保存并留痕</button>
      </view>
    </view>
  </view>

  <!-- 11. 弹窗：预付单录入与修改 -->
  <view class="modal-mask" wx:if="{{ showFinishModal && settleMode === 'prepay' }}">
    <view class="modal-box">
      <view class="modal-title">📑 预付单录入/修改</view>
      <view class="cancel-tips" wx:if="{{ paymentRetryLocked }}">上次付款结果待确认：当前表单已锁定，只能使用原内容和原流水号重试。</view>

      <view class="quick-time-grid mt-10" wx:if="{{ order.settleType === '预付款' }}">
        <view class="quick-pill {{ prepayAdjustmentMode === 'add' ? 'quick-pill-active' : '' }}" bindtap="switchPrepayAdjustmentMode" data-mode="add">追加收款</view>
        <view class="quick-pill {{ prepayAdjustmentMode === 'correct' ? 'quick-pill-active' : '' }}" bindtap="switchPrepayAdjustmentMode" data-mode="correct">修正累计金额/渠道</view>
      </view>
      <view class="cancel-tips" wx:if="{{ order.settleType === '预付款' && prepayAdjustmentMode === 'add' }}">输入的是本次新增收款，系统会自动加到已有实收。</view>
      <view class="cancel-tips" wx:if="{{ order.settleType === '预付款' && prepayAdjustmentMode === 'correct' }}">下方填写修正后的累计金额，可直接调整支付渠道或减少已收金额。</view>

      <text class="field-label">{{ prepayAdjustmentMode === 'add' ? '本次收款拆分 (元)：' : '累计实收拆分 (元)：' }}</text>
      <view class="split-pay-grid">
        <view class="split-item">
          <text class="split-label">现金</text>
          <input class="split-input" type="digit" placeholder="0" value="{{ inputCash }}" disabled="{{ paymentRetryLocked }}" bindinput="onCashInput" />
        </view>
        <view class="split-item">
          <text class="split-label">微信</text>
          <input class="split-input" type="digit" placeholder="0" value="{{ inputWechat }}" disabled="{{ paymentRetryLocked }}" bindinput="onWechatInput" />
        </view>
        <view class="split-item">
          <text class="split-label">支付宝</text>
          <input class="split-input" type="digit" placeholder="0" value="{{ inputAlipay }}" disabled="{{ paymentRetryLocked }}" bindinput="onAlipayInput" />
        </view>
      </view>

      <view class="calc-total-box prepay-box">
        <text class="calc-title">{{ prepayAdjustmentMode === 'add' ? '累计已收合计：' : '修正后实收合计：' }}</text>
        <text class="calc-num">¥{{ depositTotal }}</text>
      </view>

      <view class="field-item mt-20">
        <text class="field-label required">工程总计金额 (元)：</text>
        <input class="modal-input" type="digit" placeholder="如：800" value="{{ inputTotalAmount }}" disabled="{{ paymentRetryLocked }}" bindinput="onTotalAmountInput" />
      </view>

      <view class="calc-remain-box">
        待收剩余尾款：<text class="remain-num">¥{{ remainTotal }}</text>
      </view>

      <view class="field-item mt-20">
        <text class="field-label">同行人员（手输文本）：</text>
        <input class="modal-input" placeholder="如：学徒小赵、李师傅" value="{{ modalCompanions }}" disabled="{{ paymentRetryLocked }}" bindinput="onModalCompanionsInput" />
      </view>

      <view class="field-item mt-20">
        <text class="field-label">定金凭据/现场拍照（留痕）：</text>
        <view class="cancel-tips" wx:if="{{ pendingPaymentCloudIds.length }}">上次网络异常时已上传的凭据已保留，重试时会继续使用，不会重复上传。</view>
        <view class="upload-photo-box">
          <view class="photo-thumb" wx:for="{{ pendingPaymentCloudIds }}" wx:key="*this">
            <image class="thumb-img" src="{{ item }}" mode="aspectFill" bindtap="previewPhoto" data-url="{{ item }}" data-list="{{ pendingPaymentCloudIds }}" />
          </view>
          <view class="photo-thumb" wx:for="{{ localPhotos }}" wx:key="*this">
            <image class="thumb-img" src="{{ item }}" mode="aspectFill" />
            <text class="del-btn" bindtap="deletePhoto" data-index="{{ index }}">✕</text>
          </view>
          <view class="add-photo-btn" bindtap="chooseFinishPhoto" wx:if="{{ localPhotos.length + pendingPaymentCloudIds.length < 4 }}">
            <text class="plus">+</text>
            <text class="tip">拍凭据</text>
          </view>
        </view>
      </view>

      <view class="field-item mt-20">
        <view wx:if="{{ order.settleType === '预付款' && prepayAdjustmentMode === 'correct' }}">
          <text class="field-label required">金额修正原因：</text>
          <textarea class="modal-textarea" placeholder="修改累计金额或支付渠道时必填" value="{{ correctionReason }}" disabled="{{ paymentRetryLocked }}" bindinput="onCorrectionReasonInput" />
        </view>
        <text class="field-label">约定说明与修改备注：</text>
        <textarea class="modal-textarea" placeholder="约定上门安装时间、尾款结算方式说明等..." value="{{ modalNote }}" disabled="{{ paymentRetryLocked }}" bindinput="onModalNoteInput" />
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeFinishModal">取消</button>
        <button class="modal-btn confirm" bindtap="submitFinishOrder">确认保存并留痕</button>
      </view>
    </view>
  </view>

  <!-- 12. 弹窗：师傅/主管现场未成单确认 -->
  <view class="modal-mask" wx:if="{{ showFailModal }}">
    <view class="modal-box">
      <view class="modal-title font-red">⚠️ 标记现场未成单确认</view>
      <view class="cancel-tips">标记后将记为【现场未成单】归档，计入现场履约流失，请填写原因：</view>
      
      <view class="field-item mt-10">
        <text class="field-label required">未成理由：</text>
        <textarea 
          class="modal-textarea" 
          placeholder="如：客户不在家且拒接电话、现场情况与报修严重不符无配件等..." 
          value="{{ failReason }}" 
          bindinput="onFailReasonInput" 
        />
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeFailModal">取消</button>
        <button class="modal-btn btn-danger" bindtap="submitFailOrder">确认未成单</button>
      </view>
    </view>
  </view>
</view>
