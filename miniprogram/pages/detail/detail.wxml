<view class="container" wx:if="{{ order }}">
  <!-- 1. 工单头部状态与金额总览 -->
  <view class="detail-card header-card">
    <view class="status-badge-row">
      <text class="city-tag">{{ order.city || '未标记城市' }}</text>
      <text class="status-tag {{ order.status === '待派单' ? 'status-pending' : (order.status === '已派单' ? 'status-assigned' : (order.status === '未成单' ? 'status-fail' : 'status-done')) }}">{{ order.status }}</text>
    </view>
    <view class="urgent-banner" wx:if="{{ order.isUrgent }}">🚨 客户已催单！请优先处理</view>
    
    <!-- 预付款模式总览展示 -->
    <view class="amount-banner prepay-banner" wx:if="{{ order.settleType === '预付款' }}">
      <view class="banner-title">📑 工程总计：¥{{ order.totalAmount || 0 }}</view>
      <view class="banner-sub">
        已收定金合计：<text class="bold-text">¥{{ order.depositAmount || order.finalAmount || 0 }}</text>（待收尾款：¥{{ order.remainingAmount || 0 }}）
      </view>
      <view class="banner-split" wx:if="{{ order.wechatAmount || order.alipayAmount || order.cashAmount }}">
        渠道明细：微信 ¥{{ order.wechatAmount || 0 }} | 支付宝 ¥{{ order.alipayAmount || 0 }} | 现金 ¥{{ order.cashAmount || 0 }}
      </view>
    </view>

    <!-- 全款完工模式总览展示 -->
    <view class="amount-banner" wx:elif="{{ order.status === '已完工' && (order.finalAmount || order.totalAmount) }}">
      <view class="banner-title">💰 实收合计金额：¥{{ order.finalAmount || 0 }}</view>
      <view class="banner-split" wx:if="{{ order.wechatAmount || order.alipayAmount || order.cashAmount }}">
        渠道明细：微信 ¥{{ order.wechatAmount || 0 }} | 支付宝 ¥{{ order.alipayAmount || 0 }} | 现金 ¥{{ order.cashAmount || 0 }}
      </view>
    </view>
  </view>

  <!-- 2. 工单基础信息 -->
  <view class="detail-card">
    <view class="section-title">📋 基础信息</view>
    <view class="info-row">
      <text class="info-label">客户电话：</text>
      <text class="info-val phone" bindtap="callCustomer">{{ order.customerPhone }} 📞</text>
    </view>
    <view class="info-row">
      <text class="info-label">服务地址：</text>
      <text class="info-val">{{ order.address ? '📍 ' + order.address : '-' }}</text>
    </view>
    <view class="info-row">
      <text class="info-label">预约时间：</text>
      <text class="info-val highlight">{{ order.appointmentTime }}</text>
    </view>
    <view class="info-row">
      <text class="info-label">主派师傅：</text>
      <text class="info-val highlight">{{ order.workerName || '未指派' }}</text>
    </view>
    <view class="info-row" wx:if="{{ order.workerGroupId }}">
      <text class="info-label">师傅群号：</text>
      <text class="info-val">{{ order.workerGroupId }}</text>
    </view>
    <view class="info-row" wx:if="{{ order.companionWorkers }}">
      <text class="info-label">同行人员：</text>
      <text class="info-val">{{ order.companionWorkers }}</text>
    </view>
    <view class="info-row" wx:if="{{ order.source }}">
      <text class="info-label">订单来源：</text>
      <text class="info-val">{{ order.source }}</text>
    </view>
    <!-- 🌟 展示录单人信息 -->
    <view class="info-row" wx:if="{{ order.creatorName }}">
      <text class="info-label">录单人：</text>
      <text class="info-val">{{ order.creatorName }}</text>
    </view>
    <!-- 准确格式化的结算时间 -->
    <view class="info-row" wx:if="{{ order.finishTime }}">
      <text class="info-label">{{ order.settleType === '预付款' ? '最新收款时间：' : '结算时间：' }}</text>
      <text class="info-val">{{ order.finishTimeFormatted || order.finishTime }}</text>
    </view>
  </view>

  <!-- 3. 最新施工凭证照片 -->
  <view class="detail-card" wx:if="{{ order.finishPhotos && order.finishPhotos.length }}">
    <view class="section-title">📸 最新完工凭据照片</view>
    <view class="photo-grid">
      <image 
        class="finish-img" 
        wx:for="{{ order.finishPhotos }}" 
        wx:key="*this" 
        src="{{ item }}" 
        mode="aspectFill" 
        bindtap="previewPhoto" 
        data-url="{{ item }}"
        data-list="{{ order.finishPhotos }}"
      />
    </view>
    <view class="finish-note" wx:if="{{ order.finishNote }}">
      <text class="note-label">施工说明：</text>{{ order.finishNote }}
    </view>
  </view>

  <!-- 4. 操作按钮栏（位于流水与回馈上方，层级清晰） -->
  <view class="actions-bar">
    <!-- 仅客服可见：催单 -->
    <button 
      class="btn-action btn-urgent" 
      wx:if="{{ currentUser && currentUser.role === 'service' && order.status !== '已完工' && order.status !== '未成单' }}" 
      bindtap="triggerUrgent"
    >
      🚨 催单
    </button>

    <!-- 仅管理员可见：指派/改派师傅 -->
    <picker 
      wx:if="{{ currentUser && currentUser.role === 'admin' && order.status !== '已完工' && order.status !== '未成单' }}" 
      bindchange="onAssignWorker" 
      range="{{ candidateWorkerNames }}"
      class="picker-btn-wrapper"
    >
      <button class="btn-action btn-assign">
        {{ order.workerName ? '改派师傅' : '指派师傅' }}
      </button>
    </picker>

    <!-- 🌟 恢复：工单进度回馈按钮（未成单外均可回馈） -->
    <button 
      class="btn-action btn-feedback" 
      wx:if="{{ order.status !== '未成单' }}" 
      bindtap="openFeedbackModal"
    >
      💬 进度回馈
    </button>

    <!-- 仅师傅可见：未成单 -->
    <button 
      class="btn-action btn-fail" 
      wx:if="{{ currentUser && currentUser.role === 'worker' && order.status !== '未成单' && order.status !== '已完工' }}" 
      bindtap="markFail"
    >
      未成单
    </button>

    <!-- 仅师傅可见：预付单（二选一互斥） -->
    <button 
      class="btn-action btn-prepay" 
      wx:if="{{ currentUser && currentUser.role === 'worker' && order.status !== '未成单' && (!order.settleType || order.settleType === '预付款') }}" 
      bindtap="openPrepayModal"
    >
      {{ order.settleType === '预付款' ? (order.remainingAmount > 0 ? '续收/结清尾款' : '修改预付单') : '预付单' }}
    </button>

    <!-- 仅师傅可见：全款结单（二选一互斥） -->
    <button 
      class="btn-action btn-done" 
      wx:if="{{ currentUser && currentUser.role === 'worker' && order.status !== '未成单' && (!order.settleType || order.settleType === '全款') }}" 
      bindtap="openFinishModal"
    >
      {{ order.settleType === '全款' ? '修改全款结算' : '全款结单' }}
    </button>
  </view>

  <!-- 5. 🌟 恢复：施工与进度回馈记录流 -->
  <view class="detail-card" wx:if="{{ order.feedbacks && order.feedbacks.length }}">
    <view class="section-title">💬 施工与进度回馈 ({{ order.feedbacks.length }})</view>
    <view class="log-timeline">
      <view class="log-item feedback-log-item" wx:for="{{ order.feedbacks }}" wx:key="id">
        <view class="log-header">
          <view class="log-time">{{ item.timeFormatted || item.time }}</view>
          <view class="log-operator">{{ item.operatorName }} ({{ item.operatorRole === 'worker' ? '师傅' : (item.operatorRole === 'service' ? '客服' : '管理') }})</view>
        </view>
        <view class="log-body">
          <view class="feedback-text">{{ item.content }}</view>
          <view class="log-photos" wx:if="{{ item.photos && item.photos.length }}">
            <image 
              class="log-thumb" 
              wx:for="{{ item.photos }}" 
              wx:for-item="p" 
              wx:key="*this" 
              src="{{ p }}" 
              mode="aspectFill"
              bindtap="previewPhoto"
              data-url="{{ p }}"
              data-list="{{ item.photos }}"
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 6. 支付与修改历史记录流水 -->
  <view class="detail-card" wx:if="{{ order.paymentLogs && order.paymentLogs.length }}">
    <view class="section-title">📜 支付与修改记录 ({{ order.paymentLogs.length }})</view>
    <view class="log-timeline">
      <view class="log-item" wx:for="{{ order.paymentLogs }}" wx:key="id">
        <view class="log-header">
          <view class="log-time">{{ item.timeFormatted || item.time }}</view>
          <view class="log-operator">{{ item.operatorName }} ({{ item.operatorRole === 'worker' ? '师傅' : '管理' }})</view>
        </view>
        
        <view class="log-body">
          <view class="log-type-tag {{ item.settleType === '全款' ? 'tag-full' : 'tag-prepay' }}">
            {{ item.settleType }}记录
          </view>
          
          <view class="log-amount-row" wx:if="{{ item.settleType === '全款' }}">
            <text class="log-strong">实收合计：¥{{ item.currentPaid }}</text>
            <text class="log-sub">（现金:{{ item.cashAmount || 0 }} / 微信:{{ item.wechatAmount || 0 }} / 支付宝:{{ item.alipayAmount || 0 }}）</text>
          </view>
          
          <view class="log-amount-row" wx:if="{{ item.settleType === '预付款' }}">
            <text class="log-strong">定金合计：¥{{ item.currentPaid }}</text>
            <text class="log-sub">（总计:¥{{ item.totalAmount }} / 待收尾款:¥{{ item.remainingAmount }}）</text>
          </view>

          <view class="log-companion" wx:if="{{ item.companionWorkers }}">
            👥 同行人员：{{ item.companionWorkers }}
          </view>

          <view class="log-note" wx:if="{{ item.note }}">
            📝 备注：{{ item.note }}
          </view>

          <view class="log-photos" wx:if="{{ item.photos && item.photos.length }}">
            <image 
              class="log-thumb" 
              wx:for="{{ item.photos }}" 
              wx:for-item="p" 
              wx:key="*this" 
              src="{{ p }}" 
              mode="aspectFill"
              bindtap="previewPhoto"
              data-url="{{ p }}"
              data-list="{{ item.photos }}"
            />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 7. 进度回馈录入弹窗 -->
  <view class="modal-mask" wx:if="{{ showFeedbackModal }}">
    <view class="modal-box">
      <view class="modal-title">💬 提交施工与进度回馈</view>
      
      <view class="field-item">
        <text class="field-label required">回馈内容说明：</text>
        <textarea 
          class="modal-textarea" 
          placeholder="如：已上门排查，主板受潮需更换配件；或客户改约明日等..." 
          value="{{ feedbackContent }}" 
          bindinput="onFeedbackContentInput" 
        />
      </view>

      <view class="field-item mt-20">
        <text class="field-label">现场照片（选填，支持多张）：</text>
        <view class="upload-photo-box">
          <view class="photo-thumb" wx:for="{{ feedbackPhotos }}" wx:key="*this">
            <image class="thumb-img" src="{{ item }}" mode="aspectFill" />
            <text class="del-btn" bindtap="deleteFeedbackPhoto" data-index="{{ index }}">✕</text>
          </view>
          <view class="add-photo-btn" bindtap="chooseFeedbackPhoto" wx:if="{{ feedbackPhotos.length < 4 }}">
            <text class="plus">+</text>
            <text class="tip">拍现场</text>
          </view>
        </view>
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeFeedbackModal">取消</button>
        <button class="modal-btn confirm" bindtap="submitFeedback">提交回馈</button>
      </view>
    </view>
  </view>

  <!-- 8. 专属弹窗：全款完工结单录入/修改 -->
  <view class="modal-mask" wx:if="{{ showFinishModal && settleMode === 'full' }}">
    <view class="modal-box">
      <view class="modal-title">🎉 全款完工结单录入/修改</view>

      <view class="split-pay-grid">
        <view class="split-item">
          <text class="split-label">现金 (元)</text>
          <input 
            class="split-input" 
            type="digit" 
            placeholder="0" 
            value="{{ inputCash }}" 
            bindinput="onCashInput" 
          />
        </view>
        <view class="split-item">
          <text class="split-label">微信 (元)</text>
          <input 
            class="split-input" 
            type="digit" 
            placeholder="0" 
            value="{{ inputWechat }}" 
            bindinput="onWechatInput" 
          />
        </view>
        <view class="split-item">
          <text class="split-label">支付宝 (元)</text>
          <input 
            class="split-input" 
            type="digit" 
            placeholder="0" 
            value="{{ inputAlipay }}" 
            bindinput="onAlipayInput" 
          />
        </view>
      </view>

      <view class="calc-total-box">
        <text class="calc-title">实收合计金额：</text>
        <text class="calc-num">¥{{ fullTotal }}</text>
      </view>

      <view class="field-item mt-20">
        <text class="field-label">同行人员（手输文本）：</text>
        <input 
          class="modal-input" 
          placeholder="如：学徒小张、王师傅（无则留空）" 
          value="{{ modalCompanions }}" 
          bindinput="onModalCompanionsInput" 
        />
      </view>

      <view class="field-item mt-20">
        <text class="field-label">本次施工拍照留痕（可多次补拍）：</text>
        <view class="upload-photo-box">
          <view class="photo-thumb" wx:for="{{ localPhotos }}" wx:key="*this">
            <image class="thumb-img" src="{{ item }}" mode="aspectFill" />
            <text class="del-btn" bindtap="deletePhoto" data-index="{{ index }}">✕</text>
          </view>
          <view class="add-photo-btn" bindtap="chooseFinishPhoto" wx:if="{{ localPhotos.length < 4 }}">
            <text class="plus">+</text>
            <text class="tip">拍现场</text>
          </view>
        </view>
      </view>

      <view class="field-item mt-20">
        <text class="field-label">施工/修改备注说明：</text>
        <textarea 
          class="modal-textarea" 
          placeholder="更换明细、费用调整原因等..." 
          value="{{ modalNote }}" 
          bindinput="onModalNoteInput" 
        />
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeFinishModal">取消</button>
        <button class="modal-btn confirm" bindtap="submitFinishOrder">确认保存并留痕</button>
      </view>
    </view>
  </view>

  <!-- 9. 专属弹窗：预付单录入与修改 -->
  <view class="modal-mask" wx:if="{{ showFinishModal && settleMode === 'prepay' }}">
    <view class="modal-box">
      <view class="modal-title">📑 预付单录入/修改</view>

      <text class="field-label">已收定金拆分 (元)：</text>
      <view class="split-pay-grid">
        <view class="split-item">
          <text class="split-label">现金</text>
          <input 
            class="split-input" 
            type="digit" 
            placeholder="0" 
            value="{{ inputCash }}" 
            bindinput="onCashInput" 
          />
        </view>
        <view class="split-item">
          <text class="split-label">微信</text>
          <input 
            class="split-input" 
            type="digit" 
            placeholder="0" 
            value="{{ inputWechat }}" 
            bindinput="onWechatInput" 
          />
        </view>
        <view class="split-item">
          <text class="split-label">支付宝</text>
          <input 
            class="split-input" 
            type="digit" 
            placeholder="0" 
            value="{{ inputAlipay }}" 
            bindinput="onAlipayInput" 
          />
        </view>
      </view>

      <view class="calc-total-box prepay-box">
        <text class="calc-title">已收定金合计：</text>
        <text class="calc-num">¥{{ depositTotal }}</text>
      </view>

      <view class="field-item mt-20">
        <text class="field-label required">工程总计金额 (元)：</text>
        <input 
          class="modal-input" 
          type="digit" 
          placeholder="如：800" 
          value="{{ inputTotalAmount }}" 
          bindinput="onTotalAmountInput" 
        />
      </view>

      <view class="calc-remain-box">
        待收剩余尾款：<text class="remain-num">¥{{ remainTotal }}</text>
      </view>

      <view class="field-item mt-20">
        <text class="field-label">同行人员（手输文本）：</text>
        <input 
          class="modal-input" 
          placeholder="如：学徒小赵、李师傅" 
          value="{{ modalCompanions }}" 
          bindinput="onModalCompanionsInput" 
        />
      </view>

      <view class="field-item mt-20">
        <text class="field-label">定金凭据/现场拍照（留痕）：</text>
        <view class="upload-photo-box">
          <view class="photo-thumb" wx:for="{{ localPhotos }}" wx:key="*this">
            <image class="thumb-img" src="{{ item }}" mode="aspectFill" />
            <text class="del-btn" bindtap="deletePhoto" data-index="{{ index }}">✕</text>
          </view>
          <view class="add-photo-btn" bindtap="chooseFinishPhoto" wx:if="{{ localPhotos.length < 4 }}">
            <text class="plus">+</text>
            <text class="tip">拍凭据</text>
          </view>
        </view>
      </view>

      <view class="field-item mt-20">
        <text class="field-label">约定说明与修改备注：</text>
        <textarea 
          class="modal-textarea" 
          placeholder="约定上门安装时间、尾款结算方式说明等..." 
          value="{{ modalNote }}" 
          bindinput="onModalNoteInput" 
        />
      </view>

      <view class="modal-btns mt-30">
        <button class="modal-btn cancel" bindtap="closeFinishModal">取消</button>
        <button class="modal-btn confirm" bindtap="submitFinishOrder">确认保存并留痕</button>
      </view>
    </view>
  </view>
</view>