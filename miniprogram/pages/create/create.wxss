page {
  background-color: #f6f7f9;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}

.container {
  display: block !important;
  width: 100% !important;
  padding: 24rpx !important;
  padding-bottom: 60rpx !important;
  box-sizing: border-box !important;
}

.card {
  width: 100% !important;
  box-sizing: border-box !important;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}

.form-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 16rpx;
}

.form-group {
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.label {
  font-size: 28rpx;
  color: #444444;
}

.helper-text {
  font-size: 22rpx;
  color: #10aeff;
}

.req {
  color: #e64340;
}

.input {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border: 1rpx solid #e2e8f0;
  height: 84rpx;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8f0;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background: #f7f8fa;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-submit {
  width: 100% !important;
  box-sizing: border-box !important;
  background-color: #07c160 !important;
  color: #ffffff !important;
  font-size: 30rpx !important;
  font-weight: bold !important;
  margin-top: 40rpx !important;
  height: 84rpx !important;
  line-height: 84rpx !important;
  border-radius: 12rpx !important;
}