page {
  background-color: #f6f7f9;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 30rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #334155;
  display: block;
  margin-bottom: 12rpx;
}

.required::after {
  content: " *";
  color: #ef4444;
}

/* 统一输入框规范样式 */
.form-input {
  width: 100%;
  height: 84rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
}

/* 统一文本域规范样式 */
.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
  line-height: 1.5;
}

/* 地址组合输入行 */
.address-row {
  display: flex;
  gap: 14rpx;
}

.city-picker-btn {
  height: 84rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #2563eb;
  font-weight: 500;
  flex-shrink: 0;
  box-sizing: border-box;
}

.address-input {
  flex: 1;
}

/* 下拉选择框容器统一为输入框样式 */
.picker-inner {
  width: 100%;
  height: 84rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  font-size: 28rpx;
}

.picker-text.text-gray {
  color: #64748b;
}

.picker-text.text-bold {
  color: #07c160;
  font-weight: bold;
}

.picker-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.group-badge {
  font-size: 20rpx;
  background: #e0f2fe;
  color: #0284c7;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.arrow-down {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 快捷胶囊 */
.quick-pill-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.quick-pill {
  font-size: 24rpx;
  color: #475569;
  background: #f1f5f9;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
}

.quick-pill:active {
  background: #e2e8f0;
}

/* 提交按钮 */
.btn-submit {
  background: #07c160 !important;
  color: #ffffff !important;
  font-size: 30rpx !important;
  font-weight: 500 !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 14rpx !important;
  margin-top: 40rpx !important;
}