page {
  background-color: #f6f7f9;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
  padding-bottom: 20rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.required::after {
  content: " *";
  color: #e53935;
}

.input {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

/* 城市内嵌在地址输入框左侧 */
.address-input-group {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  height: 84rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.city-inline-picker {
  flex-shrink: 0;
  height: 100%;
}

.city-inline-btn {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 20rpx;
  background: #f1f5f9;
  border-right: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 500;
  white-space: nowrap;
}

.address-inline-input {
  flex: 1;
  height: 84rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 快捷时间胶囊 */
.quick-time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.quick-tag {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  background: #f1f5f9;
  color: #475569;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
}

.picker-value {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #334155;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  color: #94a3b8;
  font-size: 22rpx;
}

.group-tip {
  font-size: 22rpx;
  color: #07c160;
  margin-top: 10rpx;
  background: #e8f8f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.btn-submit {
  background-color: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  margin-top: 40rpx;
}