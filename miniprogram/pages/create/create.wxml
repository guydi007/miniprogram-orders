<view class="container">
  <view class="card">
    <view class="form-title">新建派单</view>

    <!-- 预约时间（支持智能补全） -->
    <view class="form-group">
  <view class="label-row">
    <text class="label">预约时间 <text class="req">*</text></text>
    <text class="helper-text">支持快捷选择时段</text>
  </view>
  <input class="input" placeholder="例如：今天 下午 或 2026-08-30 下午" value="{{ appointmentTime }}" bindinput="onAppointmentTimeInput" bindblur="onAppointmentTimeBlur" />
  
  <!-- 快捷时段标签 -->
  <view class="quick-tags">
    <text class="tag" bindtap="setQuickTime" data-val="今天 早上">今天 早上</text>
    <text class="tag" bindtap="setQuickTime" data-val="今天 上午">今天 上午</text>
    <text class="tag" bindtap="setQuickTime" data-val="今天 下午">今天 下午</text>
    <text class="tag" bindtap="setQuickTime" data-val="明天 早上">明天 早上</text>
    <text class="tag" bindtap="setQuickTime" data-val="明天 上午">明天 上午</text>
    <text class="tag" bindtap="setQuickTime" data-val="明天 下午">明天 下午</text>
  </view>
</view>

    <view class="form-group">
      <text class="label">客户电话 <text class="req">*</text></text>
      <input class="input" type="number" placeholder="请输入客户手机号" value="{{ form.customerPhone }}" bindinput="onInput" data-field="customerPhone" />
    </view>

    <view class="form-group">
      <text class="label">服务地址 <text class="req">*</text></text>
      <input class="input" placeholder="请输入详细地址（小区/门牌号）" value="{{ form.address }}" bindinput="onInput" data-field="address" />
    </view>

    <view class="form-group">
      <text class="label">订单来源</text>
      <input class="input" placeholder="例如：美团 / 电话咨询 / 熟人介绍" value="{{ form.source }}" bindinput="onInput" data-field="source" />
    </view>

    <view class="form-group">
      <text class="label">订单备注</text>
      <textarea class="textarea" placeholder="填写客户需求细节、注意事项等..." value="{{ form.remark }}" bindinput="onInput" data-field="remark" />
    </view>

    <button class="btn-submit" bindtap="submitOrder">确认创建工单</button>
  </view>
</view>