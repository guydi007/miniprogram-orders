<view class="container">
  <view class="form-card">
    <view class="card-title">📝 录入新工单</view>

    <!-- 1. 客户电话 -->
    <view class="form-item">
      <text class="form-label required">客户电话</text>
      <input 
        class="form-input" 
        type="number" 
        maxlength="11" 
        placeholder="请输入11位客户手机号" 
        value="{{ customerPhone }}" 
        bindinput="onPhoneInput" 
      />
    </view>

    <!-- 2. 服务城市与地址 -->
    <view class="form-item">
      <text class="form-label required">服务城市与地址</text>
      <view class="address-row">
        <!-- 修正：绑定 availableCities -->
        <picker bindchange="onCityChange" value="{{ cityIndex }}" range="{{ availableCities }}">
          <view class="city-picker-btn">
            <text>{{ availableCities[cityIndex] || '城市' }}</text>
            <text class="arrow-down">▼</text>
          </view>
        </picker>
        <input 
          class="form-input address-input" 
          placeholder="如：和平区南京路诚基中心3号楼" 
          value="{{ address }}" 
          bindinput="onAddressInput" 
        />
      </view>
    </view>

    <!-- 3. 预约上门时间 -->
    <view class="form-item">
      <text class="form-label required">预约上门时间</text>
      <input 
        class="form-input" 
        placeholder="如：2026-09-02 上午（支持输入今天下午/明天等）" 
        value="{{ appointmentTime }}" 
        bindinput="onTimeInput" 
        bindblur="onTimeBlur"
      />
      <view class="quick-pill-grid">
        <view class="quick-pill" bindtap="onQuickTime" data-val="今天 早上">当天早上</view>
        <view class="quick-pill" bindtap="onQuickTime" data-val="今天 上午">当天上午</view>
        <view class="quick-pill" bindtap="onQuickTime" data-val="今天 下午">当天下午</view>
        <view class="quick-pill" bindtap="onQuickTime" data-val="今天 晚上">当天晚上</view>
        <view class="quick-pill" bindtap="onQuickTime" data-val="明天 早上">明天早上</view>
        <view class="quick-pill" bindtap="onQuickTime" data-val="明天 上午">明天上午</view>
        <view class="quick-pill" bindtap="onQuickTime" data-val="明天 下午">明天下午</view>
        <view class="quick-pill" bindtap="onQuickTime" data-val="明天 晚上">明天晚上</view>
      </view>
    </view>

    <!-- 4. 指派师傅（修正：开放给拥有派单权的主管） -->
    <view class="form-item" wx:if="{{ currentUser && currentUser.role === 'leader' }}">
      <text class="form-label">指派师傅</text>
      <picker bindchange="onWorkerChange" value="{{ workerIndex }}" range="{{ workerNames }}">
        <view class="picker-inner">
          <text class="picker-text {{ workerIndex === 0 ? 'text-gray' : 'text-bold' }}">{{ workerNames[workerIndex] || '暂不指派' }}</text>
          <view class="picker-right">
            <text class="group-badge" wx:if="{{ currentWorkerGroup }}">群：{{ currentWorkerGroup }}</text>
            <text class="arrow-down">▼</text>
          </view>
        </view>
      </picker>
    </view>

    <!-- 5. 订单来源 -->
    <view class="form-item">
      <text class="form-label">订单来源</text>
      <!-- 修正：绑定 sourceNames -->
      <picker bindchange="onSourceChange" value="{{ sourceIndex }}" range="{{ sourceNames }}">
        <view class="picker-inner">
          <text class="picker-text text-bold">{{ sourceNames[sourceIndex] || '请选择订单来源' }}</text>
          <text class="arrow-down">▼</text>
        </view>
      </picker>
    </view>

    <!-- 6. 初始回馈/备注 -->
    <view class="form-item">
      <text class="form-label">初始回馈 / 备注</text>
      <!-- 修正：绑定 feedback 与 onFeedbackInput -->
      <textarea 
        class="form-textarea" 
        placeholder="录入客户特殊要求、现场注意事项、初次沟通进展等（选填）" 
        value="{{ feedback }}" 
        bindinput="onFeedbackInput" 
      />
    </view>

    <!-- 7. 提交按钮 -->
    <button class="btn-submit" bindtap="submitOrder">立即录入并派单</button>
  </view>
</view>