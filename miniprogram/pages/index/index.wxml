<view class="container">
  <!-- 1. 顶部个人身份卡片与同行按钮操作区 -->
  <view class="user-header-card" bindtap="handleUserHeaderTap">
    <view class="user-info">
      <text class="user-avatar">👤</text>
      <view class="user-detail">
        <view class="name-row">
          <text class="user-name">{{ currentUser.name || '未认证员工' }}</text>
          <text class="role-badge role-{{ currentUser.role || 'unbound' }}">{{ currentUser.role === 'admin' ? '管理' : (currentUser.role === 'leader' ? '主管' : (currentUser.role === 'service' ? '客服' : (currentUser.role === 'worker' ? '师傅' : '待核验'))) }}</text>
          <text class="test-icon-badge" wx:if="{{ currentUser.isTest }}">🧪</text>
        </view>
        <view class="sub-info-row">
          <text class="user-phone">{{ currentUser.phone || '点此绑定手机号' }}</text>
          <text class="city-tag" wx:if="{{ currentUser && currentUser.cities && currentUser.cities.length }}">
            {{ currentUser.cities.join('/') }}
          </text>
        </view>
      </view>
    </view>

    <!-- 顶部操作按钮区：师傅角色隐藏该区域，消除空灰线 -->
    <view class="header-actions" catchtap="stopBubble" wx:if="{{ currentUser && currentUser.role !== 'worker' }}">
      <button 
        class="btn-action btn-create" 
        wx:if="{{ currentUser.role === 'service' || currentUser.role === 'leader' }}" 
        bindtap="goToCreate"
      >
        + 录单
      </button>
      <button 
        class="btn-action btn-batch" 
        wx:if="{{ currentUser.role === 'leader' }}" 
        bindtap="toggleBatchMode"
      >
        {{ isBatchMode ? '退出' : '☑️ 批量' }}
      </button>
      <button 
        class="btn-action btn-stats" 
        wx:if="{{ currentUser.role === 'admin' || currentUser.role === 'leader' }}" 
        bindtap="goToStats"
      >
        📊 营收
      </button>
      <button 
        class="btn-action btn-manage" 
        wx:if="{{ currentUser.role === 'admin' }}" 
        bindtap="openUserManageModal"
      >
        ⚙️ 管理
      </button>
    </view>
  </view>


  <!-- 2. 城市过滤筛选栏 -->
  <view class="admin-city-bar" wx:if="{{ currentUser && (currentUser.role === 'admin' || currentUser.role === 'service' || currentUser.role === 'leader') && userVisibleCities.length > 0 }}">
    <scroll-view scroll-x class="city-scroll" enable-flex>
      <view 
        class="city-chip {{ selectedCityFilter === 'all' ? 'city-chip-active' : '' }}" 
        bindtap="onCityFilterChange" 
        data-city="all"
      >
        全部城市
      </view>
      <view 
        class="city-chip {{ selectedCityFilter === item ? 'city-chip-active' : '' }}" 
        wx:for="{{ userVisibleCities }}" 
        wx:key="*this" 
        bindtap="onCityFilterChange" 
        data-city="{{ item }}"
      >
        {{ item }}
      </view>
    </scroll-view>
  </view>

  <!-- 3. 时间维度筛选栏 -->
  <view class="time-filter-bar">
    <view class="time-scroll">
      <view 
        class="time-chip {{ timeFilterType === 'today' ? 'time-chip-active' : '' }}" 
        bindtap="onTimeFilterChange" 
        data-type="today"
      >
        今日
      </view>
      <view 
        class="time-chip {{ timeFilterType === 'tomorrow' ? 'time-chip-active' : '' }}" 
        bindtap="onTimeFilterChange" 
        data-type="tomorrow"
      >
        次日
      </view>
      <view 
        class="time-chip {{ timeFilterType === 'week' ? 'time-chip-active' : '' }}" 
        bindtap="onTimeFilterChange" 
        data-type="week"
      >
        本周
      </view>
      <picker mode="date" bindchange="onCustomDateChange">
        <view class="time-chip {{ timeFilterType === 'custom' ? 'time-chip-active' : '' }}">
          {{ customDateText || '自定义 ▾' }}
        </view>
      </picker>
      <view 
        class="time-chip {{ timeFilterType === 'all' ? 'time-chip-active' : '' }}" 
        bindtap="onTimeFilterChange" 
        data-type="all"
      >
        全部
      </view>
    </view>
  </view>

  <!-- 4. 工单状态分类 Tab 与数量统计 -->
  <view class="status-tab-bar">
    <view 
      class="tab-item {{ currentTab === item.key ? 'tab-item-active' : '' }}" 
      wx:for="{{ tabList }}" 
      wx:key="key" 
      bindtap="onTabChange" 
      data-key="{{ item.key }}"
    >
      <text class="tab-label">{{ item.label }}</text>
      <text class="tab-count {{ currentTab === item.key ? 'count-active' : '' }}">{{ statusCounts[item.key] || 0 }}</text>
      <view class="tab-line" wx:if="{{ currentTab === item.key }}"></view>
    </view>
  </view>

  <!-- 5. 检索区域 -->
  <view class="search-bar">
    <input 
      class="search-input" 
      placeholder="🔍 搜索城市 / 电话 / 地址 / 师傅姓名" 
      value="{{ searchKey }}" 
      bindinput="onSearchInput" 
    />
  </view>

  <!-- 6. 订单列表 -->
  <view class="order-list" style="padding-bottom: {{ isBatchMode ? '140rpx' : '0' }};">
    <view 
      class="order-card" 
      wx:for="{{ filteredOrders }}" 
      wx:key="_id" 
      bindtap="{{ isBatchMode ? (item.status !== '已完工' && item.status !== '未成单' ? 'onToggleSelectOrder' : '') : 'goToDetail' }}" 
      data-id="{{ item._id }}"
    >
      <view class="card-top">
        <view class="top-left">
          <!-- 仅待派单与已派单支持批量勾选，防止结单倒流 -->
          <checkbox 
            wx:if="{{ isBatchMode && item.status !== '已完工' && item.status !== '未成单' }}" 
            value="{{ item._id }}" 
            checked="{{ selectedOrderMap[item._id] }}" 
            catchtap="onToggleSelectOrder" 
            data-id="{{ item._id }}" 
            style="margin-right: 12rpx;" 
          />
          <text class="city-badge" wx:if="{{ item.city }}">{{ item.city }}</text>
          <text class="time">📅 {{ item.appointmentTime || '待定' }}</text>
        </view>
        <text class="status-tag {{ item.status === '待派单' ? 'status-pending' : (item.status === '已派单' ? 'status-assigned' : (item.status === '未成单' ? 'status-fail' : 'status-done')) }}">{{ item.status }}</text>
      </view>

      <view class="card-body">
        <view class="row">
          <text class="item-label">客户电话：</text>
          <text class="item-val font-number">{{ item.customerPhone || '-' }}</text>
        </view>
        <view class="row">
          <text class="item-label">服务地址：</text>
          <text class="item-val">{{ item.address ? '📍 ' + item.address : '-' }}</text>
        </view>
        <view class="row">
          <text class="item-label">指派师傅：</text>
          <text class="item-val highlight">{{ item.workerName || '未指派' }}</text>
        </view>
        <view class="row" wx:if="{{ item.companionWorkers }}">
          <text class="item-label">同行人员：</text>
          <text class="item-val">{{ item.companionWorkers }}</text>
        </view>
        <view class="row" wx:if="{{ item.settleType === '预付款' }}">
          <text class="item-label">预付收款：</text>
          <text class="item-val amount-val">定金合计 ¥{{ item.depositAmount || item.finalAmount }}（待收尾款 ¥{{ item.remainingAmount || 0 }}）</text>
        </view>
        <view class="row" wx:elif="{{ item.finalAmount }}">
          <text class="item-label">实收合计：</text>
          <text class="item-val amount-val">¥{{ item.finalAmount }}</text>
        </view>
      </view>

      <view class="card-footer">
        <text class="feedback-count">💬 回馈 ({{ item.feedbacks ? item.feedbacks.length : 0 }}) · 流水 ({{ item.paymentLogs ? item.paymentLogs.length : (item.finishPhotos ? item.finishPhotos.length : 0) }})</text>
        <text class="arrow">{{ isBatchMode ? ((item.status === '已完工' || item.status === '未成单') ? '已归档' : (selectedOrderMap[item._id] ? '已勾选 ✓' : '点击勾选')) : '详情 ➔' }}</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{ filteredOrders.length === 0 }}">
      <text>{{ !currentUser ? '请先绑定手机号以查看工单' : '当前城市、时间和分类下暂无工单' }}</text>
    </view>
  </view>

  <!-- 7. 底部固定：批量派单操作悬浮条 -->
  <view class="batch-action-bar" wx:if="{{ isBatchMode }}">
    <view class="batch-info">
      已选 <text class="font-bold font-green">{{ selectedOrderIds.length }}</text> 单
    </view>
    <view class="batch-btns">
      <button class="btn-select-all" size="mini" bindtap="selectAllOrders">全选/取消</button>
      <picker bindchange="onBatchAssignWorker" range="{{ candidateWorkerNames }}" disabled="{{ selectedOrderIds.length === 0 }}">
        <button class="btn-primary {{ selectedOrderIds.length === 0 ? 'btn-disabled' : '' }}" size="mini" style="margin: 0 !important;">
          指派给师傅 ➔
        </button>
      </picker>
    </view>
  </view>

  <!-- 8. 统一员工登录弹窗：账号类型由后台自动判断 -->
  <view class="modal-mask" wx:if="{{ showPhoneModal }}">
    <view class="modal-box">
      <view class="modal-title">🔐 员工身份登录</view>
      <view class="modal-desc">{{ loginHint }}</view>

      <block wx:if="{{ loginStage === 'phone' }}">
        <input
          class="modal-input"
          type="number"
          maxlength="11"
          placeholder="请输入员工11位手机号"
          value="{{ inputPhone }}"
          bindinput="onPhoneInput"
        />
        <button class="btn-primary mt-30" bindtap="verifyAndBindPhone" loading="{{ isSubmittingPhone }}" disabled="{{ isSubmittingPhone }}">登录</button>
      </block>

      <block wx:elif="{{ loginStage === 'wechat' }}">
        <view class="modal-desc mt-16">员工手机号：{{ pendingLoginPhone }}</view>
        <button class="btn-primary mt-30" open-type="getPhoneNumber" bindgetphonenumber="verifyAndBindWechatPhone" loading="{{ isSubmittingPhone }}" disabled="{{ isSubmittingPhone }}">授权微信手机号并登录</button>
        <button class="btn-secondary mt-16" bindtap="resetLoginFlow" disabled="{{ isSubmittingPhone }}">返回修改手机号</button>
      </block>
    </view>
  </view>

  <!-- 9. 管理中心弹窗 -->
  <view class="modal-mask" wx:if="{{ showUserManageModal }}">
    <view class="modal-box user-manage-modal">
      <view class="type-switch">
        <view class="type-btn {{ userManageTab === 'list' ? 'type-active' : '' }}" bindtap="switchUserTab" data-tab="list">👥 员工 ({{ allUserList.length }})</view>
        <view class="type-btn {{ userManageTab === 'add' ? 'type-active' : '' }}" bindtap="switchUserTab" data-tab="add">➕ 录入</view>
        <view class="type-btn {{ userManageTab === 'source' ? 'type-active' : '' }}" bindtap="switchUserTab" data-tab="source">🏷️ 渠道 ({{ allSourceList.length }})</view>
        <view class="type-btn {{ userManageTab === 'groups' ? 'type-active' : '' }}" bindtap="switchUserTab" data-tab="groups">🔗 群管 ({{ notificationGroups.length }})</view>
      </view>

      <!-- 员工列表 Tab -->
      <scroll-view scroll-y class="modal-scroll-area" wx:if="{{ userManageTab === 'list' }}">
        <view class="user-manage-item" wx:for="{{ allUserList }}" wx:key="_id">
          <view class="u-info">
            <view class="u-name-line">
              <text class="u-name">{{ item.name || '未填姓名' }}</text>
              <text class="u-badge {{ item.role === 'admin' ? 'b-admin' : (item.role === 'leader' ? 'b-leader' : (item.role === 'service' ? 'b-service' : 'b-worker')) }}">{{ item.role === 'admin' ? '管理' : (item.role === 'leader' ? '主管' : (item.role === 'service' ? '客服' : '师傅')) }}</text>
              <text class="test-icon-badge" wx:if="{{ item.isTest }}">🧪</text>
            </view>
            <text class="u-phone">📞 {{ item.phone || '无电话' }}</text>
            <text class="u-sub">📍 城市：{{ item.citiesText }}</text>
            <text class="u-status {{ item.isTest ? 'test-status' : (item.openid ? 'bound' : 'unbound') }}">
              {{ item.isTest ? '🧪 免锁测试' : (item.openid ? '🟢 已绑定微信' : '⚪ 待扫码绑定') }}
            </text>
          </view>
          
          <view class="u-actions">
            <button 
              class="btn-edit-user" 
              size="mini" 
              bindtap="openEditUserModal" 
              data-user="{{ item }}"
            >
              编辑
            </button>
          </view>
        </view>
        <view class="empty-stats" wx:if="{{ allUserList.length === 0 }}">暂无员工数据</view>
      </scroll-view>

      <!-- 录入员工 Tab -->
      <scroll-view scroll-y class="modal-scroll-area" wx:if="{{ userManageTab === 'add' }}">
        <view class="form-group-box">
          <text class="field-title">员工姓名：</text>
          <input 
            class="modal-input" 
            placeholder="如：赵师傅、李主管" 
            value="{{ newUserName }}" 
            bindinput="onNewUserNameInput" 
          />

          <text class="field-title mt-16">员工手机号（登录唯一凭据）：</text>
          <input 
            class="modal-input" 
            type="number" 
            maxlength="11" 
            placeholder="请输入11位手机号" 
            value="{{ newUserPhone }}" 
            bindinput="onNewUserPhoneInput" 
          />

          <view class="role-select-box mt-16">
            <text class="field-title">分配角色：</text>
            <radio-group class="role-radio-group" bindchange="onNewUserRoleChange">
              <label class="radio-item"><radio value="worker" checked="{{ newUserRole === 'worker' }}" />师傅</label>
              <label class="radio-item"><radio value="service" checked="{{ newUserRole === 'service' }}" />客服</label>
              <label class="radio-item"><radio value="leader" checked="{{ newUserRole === 'leader' }}" />主管</label>
            </radio-group>
          </view>

          <view class="city-select-box mt-16">
            <text class="field-title">所属/管辖城市（支持多选）：</text>
            <checkbox-group class="city-checkbox-group" bindchange="onNewUserCitiesChange">
              <label class="checkbox-item" wx:for="{{ availableCities }}" wx:key="*this">
                <checkbox value="{{ item }}" checked="{{ newUserCitiesMap[item] }}" /> {{ item }}
              </label>
            </checkbox-group>
          </view>

          <view class="test-switch-row mt-16">
            <text class="test-switch-label">🧪 设为免锁测试号：</text>
            <switch checked="{{ newUserIsTest }}" color="#07c160" bindchange="onNewUserIsTestChange" />
          </view>
          <view class="test-switch-tip">开启后该账号不绑定任何微信，可在多台手机随时切换登录用于测试。</view>

          <button class="btn-primary mt-20" bindtap="submitAddUser">确认录入</button>
        </view>
      </scroll-view>

      <!-- 群管理 Tab -->
      <scroll-view scroll-y class="modal-scroll-area" wx:if="{{ userManageTab === 'groups' }}">
        <view class="form-group-box">
          <view class="user-manage-item" wx:for="{{ notificationGroups }}" wx:key="_id">
            <view class="u-info">
              <view class="u-name-line"><text class="u-name">{{ item.groupName }}</text><text class="group-type-pill {{ item.groupType === 'order_entry' ? 'group-type-entry' : (item.groupType === 'deal' ? 'group-type-deal' : 'group-type-unconverted') }}">{{ item.groupTypeLabel }}</text><text class="test-icon-badge" wx:if="{{ item.isTestGroup }}">🧪 测试</text></view>
              <text class="u-sub">📍 {{ item.city }}　📞 {{ item.phone }}</text>
              <text class="u-sub">🔐 {{ item.webhookMasked || '未配置' }}　{{ item.enabled ? '启用' : '已停用' }}</text>
            </view>
            <view><button class="btn-edit-user" size="mini" bindtap="editNotificationGroup" data-group="{{ item }}">编辑</button><button wx:if="{{ item.enabled }}" class="btn-del-source" size="mini" bindtap="disableNotificationGroup" data-id="{{ item._id }}" data-version="{{ item.version }}">停用</button><button wx:else class="btn-edit-user" size="mini" bindtap="enableNotificationGroup" data-id="{{ item._id }}" data-version="{{ item.version }}">启用</button></view>
          </view>
          <view class="empty-stats" wx:if="{{ notificationGroups.length === 0 }}">暂无群配置</view>
          <view class="form-group-box group-add-box">
            <text class="field-title">{{ editingGroupId ? '编辑通知群' : '新增通知群' }}</text>
            <input class="modal-input" placeholder="群名" value="{{ groupNameInput }}" bindinput="onGroupNameInput" />
            <picker class="group-city-picker mt-16" range="{{ availableCities }}" value="{{ groupCityIndex }}" bindchange="onGroupCityChange">
              <view class="group-city-picker-inner"><text>{{ availableCities[groupCityIndex] || '请选择所属城市' }}</text><text class="group-city-arrow">⌄</text></view>
            </picker>
            <input class="modal-input mt-16" type="number" maxlength="11" placeholder="群内@手机号" value="{{ groupPhoneInput }}" bindinput="onGroupPhoneInput" />
            <picker class="modal-input picker-input mt-16" range="{{ groupTypeOptions }}" bindchange="onGroupTypeChange"><view>{{ groupTypeOptions[groupTypeIndex] }}</view></picker>
            <input class="modal-input mt-16" password="{{true}}" placeholder="Webhook（编辑时留空表示保持原地址）" value="{{ groupWebhookInput }}" bindinput="onGroupWebhookInput" />
            <view class="test-switch-row mt-16"><text class="test-switch-label">测试群</text><switch checked="{{ groupIsTest }}" bindchange="onGroupTestChange" /></view>
            <button class="btn-primary mt-20" bindtap="createNotificationGroup">{{ editingGroupId ? '保存群配置' : '新增群配置' }}</button>
          </view>
        </view>
      </scroll-view>

      <!-- 渠道管理 Tab -->
      <scroll-view scroll-y class="modal-scroll-area" wx:if="{{ userManageTab === 'source' }}">
        <view class="form-group-box">
          <view class="source-list">
            <view class="source-item" wx:for="{{ allSourceList }}" wx:key="_id">
              <text class="source-name">{{ item.name }}</text>
              <button class="btn-del-source" size="mini" bindtap="deleteSource" data-id="{{ item._id }}" data-name="{{ item.name }}">删除</button>
            </view>
            <view class="empty-stats" wx:if="{{ allSourceList.length === 0 }}">暂无渠道数据</view>
          </view>

          <view class="add-source-bar mt-20">
            <input 
              class="modal-input add-source-input" 
              placeholder="输入新渠道（如：抖音）" 
              value="{{ newSourceName }}" 
              bindinput="onNewSourceNameInput" 
            />
            <button class="btn-add-source" bindtap="addSource">添加</button>
          </view>
        </view>
      </scroll-view>

      <view class="modal-btns mt-20">
        <button class="modal-btn cancel" bindtap="closeUserManageModal">关闭</button>
      </view>
    </view>
  </view>

  <!-- 10. 编辑员工弹窗 -->
  <view class="modal-mask edit-modal-mask" wx:if="{{ showEditUserModal }}">
    <view class="modal-box user-manage-modal">
      <view class="modal-title">✏️ 编辑员工 ({{ editingUser.name }})</view>

      <scroll-view scroll-y class="modal-scroll-area">
        <view class="form-group-box">
          <text class="field-title">员工姓名：</text>
          <input 
            class="modal-input" 
            placeholder="请输入姓名" 
            value="{{ editUserName }}" 
            bindinput="onEditUserNameInput" 
          />

          <text class="field-title mt-16">员工手机号：</text>
          <input 
            class="modal-input" 
            type="number" 
            maxlength="11" 
            placeholder="请输入11位手机号" 
            value="{{ editUserPhone }}" 
            bindinput="onEditUserPhoneInput" 
          />

          <view class="role-select-box mt-16">
            <text class="field-title">分配角色：</text>
            <view wx:if="{{ editingUser.role === 'admin' }}" style="padding: 10rpx 0;">
              <text class="u-badge b-admin">系统管理员（不可修改身份）</text>
            </view>
            <radio-group class="role-radio-group" bindchange="onEditUserRoleChange" wx:else>
              <label class="radio-item"><radio value="worker" checked="{{ editUserRole === 'worker' }}" />师傅</label>
              <label class="radio-item"><radio value="service" checked="{{ editUserRole === 'service' }}" />客服</label>
              <label class="radio-item"><radio value="leader" checked="{{ editUserRole === 'leader' }}" />主管</label>
            </radio-group>
          </view>

          <view class="city-select-box mt-16">
            <text class="field-title">所属/管辖城市（支持多选）：</text>
            <checkbox-group class="city-checkbox-group" bindchange="onEditUserCitiesChange">
              <label class="checkbox-item" wx:for="{{ availableCities }}" wx:key="*this">
                <checkbox value="{{ item }}" checked="{{ editUserCitiesMap[item] }}" /> {{ item }}
              </label>
            </checkbox-group>
          </view>

          <view class="test-switch-row mt-16">
            <text class="test-switch-label">🧪 设为免锁测试号：</text>
            <switch checked="{{ editUserIsTest }}" color="#07c160" bindchange="onEditUserIsTestChange" />
          </view>

          <view class="bind-manage-section mt-16">
            <text class="field-title">微信绑定状态：</text>
            <view class="bind-status-row">
              <text class="u-status {{ editUserIsTest ? 'test-status' : (editingUser.openid ? 'bound' : 'unbound') }}">
                {{ editUserIsTest ? '🧪 免锁测试' : (editingUser.openid ? '🟢 已绑定' : '⚪ 待绑定') }}
              </text>
              
              <button 
                class="btn-unbind" 
                size="mini" 
                bindtap="unbindUserInModal"
                wx:if="{{ editingUser.openid && !editUserIsTest && editingUser._id !== currentUser._id }}"
              >
                解绑微信
              </button>
            </view>
            <view class="self-tip" wx:if="{{ editingUser._id === currentUser._id }}">当前登录账号不可解绑自身</view>
          </view>
        </view>
      </scroll-view>

      <view class="modal-btns mt-20">
        <button class="modal-btn cancel" bindtap="closeEditUserModal">取消</button>
        <button class="modal-btn confirm" bindtap="submitEditUser">保存修改</button>
      </view>
    </view>
  </view>
</view>
