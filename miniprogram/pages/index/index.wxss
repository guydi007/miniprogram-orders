/* ==========================================================
   全局容器与卡片统一样式
   ========================================================== */
   .container {
    padding: 20rpx;
    background-color: #f6f8fa;
    min-height: 100vh;
    box-sizing: border-box;
  }
  
  /* 顶部身份卡片：流式自适应垂直排列 */
  .user-header-card {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    background: #ffffff;
    border-radius: 18rpx;
    padding: 24rpx !important;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
    box-sizing: border-box;
    width: 100% !important;
  }
  
  .user-info {
    display: flex;
    align-items: center;
    width: 100%;
  }
  
  .user-avatar {
    font-size: 50rpx;
    margin-right: 20rpx;
  }
  
  .user-detail {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .name-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .user-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333333;
  }
  
  .role-badge {
    font-size: 20rpx;
    padding: 2rpx 10rpx;
    border-radius: 6rpx;
  }
  .role-admin { background: #fee2e2; color: #ef4444; }
  .role-service { background: #e0f2fe; color: #0284c7; }
  .role-worker { background: #fef3c7; color: #d97706; }
  .role-unbound { background: #f3f4f6; color: #6b7280; }
  
  .test-icon-badge {
    font-size: 24rpx;
  }
  
  .sub-info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6rpx;
  }
  
  .user-phone {
    font-size: 26rpx;
    color: #666666;
  }
  
  .city-tag {
    font-size: 24rpx;
    color: #07c160;
    background: #f0fdf4;
    padding: 2rpx 12rpx;
    border-radius: 6rpx;
  }
  
  
  /* ==========================================================
     改进 1：城市筛选胶囊 - 减小高度并完美垂直居中
     ========================================================== */
  .admin-city-bar {
    width: 100%;
    white-space: nowrap;
    margin-bottom: 20rpx;
    box-sizing: border-box;
  }
  
  .city-scroll {
    display: flex;
    width: 100%;
    box-sizing: border-box;
  }
  
  .city-chip {
    display: inline-flex;
    align-items: center;       /* 垂直居中 */
    justify-content: center;   /* 水平居中 */
    height: 56rpx !important;  /* 减小外框高度 */
    line-height: normal !important;
    padding: 0 28rpx !important;
    margin-right: 16rpx;
    font-size: 26rpx !important;
    border-radius: 28rpx !important;
    background-color: #ffffff;
    color: #4b5563;
    border: 1rpx solid #e5e7eb;
    box-sizing: border-box;
    vertical-align: middle;
  }
  
  .city-chip-active {
    background-color: #07c160 !important;
    color: #ffffff !important;
    border-color: #07c160 !important;
  }
  
  
  /* ==========================================================
     改进 2：顶部 4 个按钮同行排布与精简样式
     ========================================================== */
  .header-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12rpx;
    width: 100%;
    border-top: 1rpx solid #f2f4f7;
    padding-top: 16rpx;
    margin-top: 16rpx;
    box-sizing: border-box;
  }
  
  .header-actions .btn-action {
    flex: 1;
    margin: 0 !important;
    text-align: center;
    font-size: 24rpx !important;
    height: 60rpx !important;
    line-height: 60rpx !important;
    padding: 0 !important;
    border-radius: 10rpx !important;
    box-sizing: border-box;
    font-weight: 500;
  }
  
  /* 4个按钮的独立配色 */
  .btn-create {
    background-color: #07c160 !important;
    color: #ffffff !important;
  }
  
  .btn-batch {
    background-color: #ff9800 !important;
    color: #ffffff !important;
  }
  
  .btn-stats {
    background-color: #f0fdf4 !important;
    color: #16a34a !important;
    border: 1rpx solid #dcfce7 !important;
  }
  
  .btn-manage {
    background-color: #f8fafc !important;
    color: #475569 !important;
    border: 1rpx solid #e2e8f0 !important;
  }
  
  
  /* ==========================================================
     工单状态 Tab 栏与检索栏
     ========================================================== */
  .status-tab-bar {
    display: flex;
    background: #ffffff;
    border-radius: 12rpx;
    padding: 10rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  }
  
  .tab-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding: 12rpx 0;
  }
  
  .tab-label {
    font-size: 26rpx;
    color: #666666;
  }
  
  .tab-count {
    font-size: 24rpx;
    color: #999999;
    margin-top: 4rpx;
  }
  
  .tab-item-active .tab-label {
    color: #07c160;
    font-weight: bold;
  }
  
  .count-active {
    color: #07c160 !important;
    font-weight: bold;
  }
  
  .tab-line {
    position: absolute;
    bottom: 0;
    width: 40rpx;
    height: 6rpx;
    background: #07c160;
    border-radius: 3rpx;
  }
  
  .search-bar {
    margin-bottom: 20rpx;
  }
  
  .search-input {
    background: #ffffff;
    border-radius: 36rpx;
    padding: 16rpx 32rpx;
    font-size: 26rpx;
    border: 1rpx solid #e5e7eb;
  }
  
  
  /* ==========================================================
     订单卡片样式
     ========================================================== */
  .order-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }
  
  .order-card {
    background: #ffffff;
    border-radius: 16rpx;
    padding: 24rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  }
  
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
    padding-bottom: 12rpx;
    border-bottom: 1rpx solid #f2f4f7;
  }
  
  .top-left {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .city-badge {
    font-size: 22rpx;
    background: #e6f4ea;
    color: #137333;
    padding: 2rpx 10rpx;
    border-radius: 4rpx;
  }
  
  .time {
    font-size: 26rpx;
    color: #333333;
    font-weight: 500;
  }
  
  .status-tag {
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 6rpx;
  }
  .status-pending { background: #fef3c7; color: #d97706; }
  .status-assigned { background: #e0f2fe; color: #0284c7; }
  .status-done { background: #dcfce7; color: #16a34a; }
  .status-fail { background: #fee2e2; color: #ef4444; }
  
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    margin-bottom: 16rpx;
  }
  
  .row {
    display: flex;
    font-size: 26rpx;
  }
  
  .item-label {
    color: #888888;
    width: 140rpx;
    flex-shrink: 0;
  }
  
  .item-val {
    color: #333333;
  }
  
  .highlight {
    color: #07c160;
    font-weight: bold;
  }
  
  .amount-val {
    color: #d97706;
    font-weight: bold;
  }
  
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12rpx;
    border-top: 1rpx solid #f2f4f7;
    font-size: 24rpx;
    color: #888888;
  }
  
  .arrow {
    color: #07c160;
    font-weight: 500;
  }
  
  .empty-state {
    text-align: center;
    padding: 80rpx 0;
    color: #999999;
    font-size: 28rpx;
  }
  
  
  /* ==========================================================
     底部悬浮条与弹窗样式
     ========================================================== */
  .batch-action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 110rpx;
    background: #ffffff;
    box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32rpx;
    box-sizing: border-box;
    z-index: 999;
  }
  
  .batch-info {
    font-size: 28rpx;
    color: #333333;
  }
  
  .batch-btns {
    display: flex;
    align-items: center;
    gap: 16rpx;
  }
  
  .btn-select-all {
    background-color: #f0f2f5;
    color: #666666;
    font-size: 24rpx;
    border-radius: 8rpx;
    padding: 10rpx 20rpx;
  }
  
  .btn-disabled {
    opacity: 0.5;
  }
  
  .modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  
  .modal-box {
    background: #ffffff;
    border-radius: 20rpx;
    width: 85%;
    padding: 40rpx;
    box-sizing: border-box;
  }
  
  .modal-title {
    font-size: 34rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    text-align: center;
  }
  
  .modal-desc {
    font-size: 28rpx;
    color: #666666;
    margin-bottom: 30rpx;
  }
  
  .modal-input {
    background: #f8fafc;
    border: 1rpx solid #e2e8f0;
    border-radius: 12rpx;
    padding: 0 24rpx;        /* 左右留白，上下为0 */
    height: 80rpx;           /* 固定输入框高度 */
    line-height: 80rpx;      /* 行高与高度一致，文字垂直居中 */
    font-size: 28rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .btn-primary {
    background-color: #07c160;
    color: #ffffff;
    border-radius: 12rpx;
    font-size: 30rpx;
    padding: 20rpx 0;
    width: 100%;
    text-align: center;
  }