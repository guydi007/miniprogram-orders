/* ==========================================================
   全局容器与卡片统一样式
   ========================================================== */
   .container {
    padding: 20rpx;
    background-color: #f6f8fa;
    min-height: 100vh;
    box-sizing: border-box;
  }
  
  /* 顶部身份卡片 */
  .user-header-card {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    background: #ffffff;
    border-radius: 18rpx;
    padding: 24rpx !important;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
    box-sizing: border-box;
    width: 100% !important;
  }
  
  .user-info {
    display: flex;
    align-items: center;
    width: 100%;
  }
  
  .user-avatar {
    font-size: 50rpx;
    margin-right: 20rpx;
  }
  
  .user-detail {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .name-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .user-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333333;
  }
  
  .role-badge {
    font-size: 20rpx;
    padding: 2rpx 10rpx;
    border-radius: 6rpx;
  }
  .role-admin { background: #fee2e2; color: #ef4444; }
  .role-leader { background: #ede9fe; color: #7c3aed; }
  .role-service { background: #e0f2fe; color: #0284c7; }
  .role-worker { background: #fef3c7; color: #d97706; }
  .role-unbound { background: #f3f4f6; color: #6b7280; }
  
  .test-icon-badge {
    font-size: 24rpx;
  }
  
  .sub-info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6rpx;
  }
  
  .user-phone {
    font-size: 26rpx;
    color: #666666;
  }
  
  .city-tag {
    font-size: 24rpx;
    color: #07c160;
    background: #f0fdf4;
    padding: 2rpx 12rpx;
    border-radius: 6rpx;
  }
  
  /* ==========================================================
     城市筛选胶囊栏
     ========================================================== */
  .admin-city-bar {
    width: 100%;
    white-space: nowrap;
    margin-bottom: 12rpx !important;
    box-sizing: border-box;
  }
  
  .city-scroll {
    display: flex;
    width: 100%;
    box-sizing: border-box;
  }
  
  .city-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52rpx !important;
    line-height: normal !important;
    padding: 0 24rpx !important;
    margin-right: 12rpx !important;
    font-size: 26rpx !important;
    border-radius: 26rpx !important;
    background-color: #ffffff;
    color: #4b5563;
    border: 1rpx solid #e5e7eb;
    box-sizing: border-box;
    vertical-align: middle;
  }
  
  .city-chip-active {
    background-color: #07c160 !important;
    color: #ffffff !important;
    border-color: #07c160 !important;
  }
  
  /* ==========================================================
     顶部 4 个按钮同行排布
     ========================================================== */
  .header-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12rpx;
    width: 100%;
    border-top: 1rpx solid #f2f4f7;
    padding-top: 16rpx;
    margin-top: 16rpx;
    box-sizing: border-box;
  }
  
  .header-actions .btn-action {
    flex: 1;
    margin: 0 !important;
    text-align: center;
    font-size: 24rpx !important;
    height: 60rpx !important;
    line-height: 60rpx !important;
    padding: 0 !important;
    border-radius: 10rpx !important;
    box-sizing: border-box;
    font-weight: 500;
  }
  
  .btn-create {
    background-color: #07c160 !important;
    color: #ffffff !important;
  }
  
  .btn-batch {
    background-color: #ff9800 !important;
    color: #ffffff !important;
  }
  
  .btn-stats {
    background-color: #f0fdf4 !important;
    color: #16a34a !important;
    border: 1rpx solid #dcfce7 !important;
  }
  
  .btn-manage {
    background-color: #f8fafc !important;
    color: #475569 !important;
    border: 1rpx solid #e2e8f0 !important;
  }
  
  /* ==========================================================
     工单状态 Tab 栏与时间维度筛选栏
     ========================================================== */
  .status-tab-bar {
    display: flex;
    background: #ffffff;
    border-radius: 12rpx;
    padding: 10rpx;
    margin-bottom: 12rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  }
  
  .tab-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding: 12rpx 0;
  }
  
  .tab-label {
    font-size: 26rpx;
    color: #666666;
  }
  
  .tab-count {
    font-size: 24rpx;
    color: #999999;
    margin-top: 4rpx;
  }
  
  .tab-item-active .tab-label {
    color: #07c160;
    font-weight: bold;
  }
  
  .count-active {
    color: #07c160 !important;
    font-weight: bold;
  }
  
  .tab-line {
    position: absolute;
    bottom: 0;
    width: 40rpx;
    height: 6rpx;
    background: #07c160;
    border-radius: 3rpx;
  }
  
  /* 时间筛选横向胶囊栏样式 */
  .time-filter-bar {
    width: 100%;
    white-space: nowrap;
    margin-bottom: 16rpx;
    box-sizing: border-box;
  }
  
  .time-scroll {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    overflow-x: auto;
  }
  
  .time-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52rpx !important;
    line-height: normal !important;
    padding: 0 28rpx !important;
    margin-right: 12rpx !important;
    font-size: 26rpx !important;
    border-radius: 26rpx !important;
    background-color: #ffffff;
    color: #4b5563;
    border: 1rpx solid #e5e7eb;
    box-sizing: border-box;
    vertical-align: middle;
    flex-shrink: 0;
  }
  
  .time-chip-active {
    background-color: #07c160 !important;
    color: #ffffff !important;
    border-color: #07c160 !important;
  }
  
  .search-bar {
    margin-bottom: 20rpx;
  }
  
  .search-input {
    background: #ffffff;
    border-radius: 36rpx;
    padding: 16rpx 32rpx;
    font-size: 26rpx;
    border: 1rpx solid #e5e7eb;
  }
  
  /* ==========================================================
     订单卡片样式
     ========================================================== */
  .order-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }
  
  .order-card {
    background: #ffffff;
    border-radius: 16rpx;
    padding: 24rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  }
  
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
    padding-bottom: 12rpx;
    border-bottom: 1rpx solid #f2f4f7;
  }
  
  .top-left {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .city-badge {
    font-size: 22rpx;
    background: #e6f4ea;
    color: #137333;
    padding: 2rpx 10rpx;
    border-radius: 4rpx;
  }
  
  .time {
    font-size: 26rpx;
    color: #333333;
    font-weight: 500;
  }
  
  .status-tag {
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 6rpx;
  }
  .status-pending { background: #fef3c7; color: #d97706; }
  .status-assigned { background: #e0f2fe; color: #0284c7; }
  .status-done { background: #dcfce7; color: #16a34a; }
  .status-fail { background: #fee2e2; color: #ef4444; }
  
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    margin-bottom: 16rpx;
  }
  
  .row {
    display: flex;
    font-size: 26rpx;
  }
  
  .item-label {
    color: #888888;
    width: 140rpx;
    flex-shrink: 0;
  }
  
  .item-val {
    color: #333333;
  }
  
  .highlight {
    color: #07c160;
    font-weight: bold;
  }
  
  .amount-val {
    color: #d97706;
    font-weight: bold;
  }
  
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12rpx;
    border-top: 1rpx solid #f2f4f7;
    font-size: 24rpx;
    color: #888888;
  }
  
  .arrow {
    color: #07c160;
    font-weight: 500;
  }
  
  .empty-state {
    text-align: center;
    padding: 80rpx 0;
    color: #999999;
    font-size: 28rpx;
  }
  
  /* ==========================================================
     弹窗与管理中心样式
     ========================================================== */
  .modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  
  .modal-box {
    background: #ffffff;
    border-radius: 20rpx;
    width: 88%;
    padding: 36rpx;
    box-sizing: border-box;
  }
  
  .user-manage-modal {
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  
  .type-switch {
    display: flex;
    background: #f1f5f9;
    border-radius: 12rpx;
    padding: 6rpx;
    margin-bottom: 20rpx;
    flex-shrink: 0;
  }
  
  .type-btn {
    flex: 1;
    text-align: center;
    font-size: 26rpx;
    padding: 14rpx 0;
    color: #64748b;
    border-radius: 8rpx;
  }
  
  .type-active {
    background: #ffffff;
    color: #07c160;
    font-weight: bold;
    box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
  }
  
  .modal-scroll-area {
    max-height: 540rpx !important;
    width: 100%;
    box-sizing: border-box;
    padding-right: 4rpx;
  }
  
  .form-group-box {
    display: flex;
    flex-direction: column;
    padding: 4rpx 0;
  }
  
  .field-title {
    font-size: 26rpx;
    color: #334155;
    font-weight: 500;
    margin-bottom: 8rpx;
    display: block;
  }
  
  .mt-16 {
    margin-top: 16rpx !important;
  }
  
  .user-manage-item {
    background: #f8fafc;
    border: 1rpx solid #e2e8f0;
    border-radius: 12rpx;
    padding: 20rpx;
    margin-bottom: 16rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }
  
  .u-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6rpx;
  }
  
  .u-name-line {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .u-name {
    font-size: 30rpx;
    font-weight: bold;
    color: #1e293b;
  }
  
  .u-badge {
    font-size: 20rpx;
    padding: 2rpx 10rpx;
    border-radius: 6rpx;
    font-weight: normal;
  }
  .b-admin { background: #fee2e2; color: #ef4444; }
  .b-leader { background: #ede9fe; color: #7c3aed; }
  .b-service { background: #e0f2fe; color: #0284c7; }
  .b-worker { background: #fef3c7; color: #d97706; }
  
  .u-phone {
    font-size: 26rpx;
    color: #475569;
  }
  
  .u-sub {
    font-size: 24rpx;
    color: #64748b;
  }
  
  .u-status {
    font-size: 22rpx;
    margin-top: 4rpx;
  }
  .test-status { color: #8b5cf6; }
  .bound { color: #10b981; }
  .unbound { color: #64748b; }
  
  .u-actions {
    margin-left: 20rpx;
    flex-shrink: 0;
  }
  
  .btn-edit-user {
    background-color: #07c160 !important;
    color: #ffffff !important;
    font-size: 24rpx !important;
    padding: 6rpx 20rpx !important;
    border-radius: 8rpx !important;
    margin: 0 !important;
    line-height: normal !important;
  }
  
  .role-radio-group, .city-checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
    margin-top: 8rpx;
  }
  
  .radio-item, .checkbox-item {
    font-size: 26rpx;
    color: #475569;
    display: flex;
    align-items: center;
    gap: 6rpx;
  }
  
  .test-switch-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .test-switch-label {
    font-size: 26rpx;
    color: #334155;
    font-weight: 500;
  }
  
  .test-switch-tip {
    font-size: 22rpx;
    color: #94a3b8;
    margin-top: 4rpx;
  }
  
  /* 微信绑定与解绑管理 */
  .bind-status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8rpx;
    background: #f8fafc;
    padding: 12rpx 16rpx;
    border-radius: 8rpx;
    border: 1rpx solid #e2e8f0;
  }
  
  .btn-unbind {
    background-color: #fee2e2 !important;
    color: #ef4444 !important;
    font-size: 24rpx !important;
    margin: 0 !important;
    padding: 4rpx 16rpx !important;
  }
  
  .self-tip {
    font-size: 22rpx;
    color: #94a3b8;
    margin-top: 4rpx;
  }
  
  .source-list {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
  }
  
  .source-item {
    background: #f8fafc;
    border: 1rpx solid #e2e8f0;
    border-radius: 10rpx;
    padding: 16rpx 20rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .source-name {
    font-size: 28rpx;
    color: #334155;
    font-weight: 500;
  }
  
  .btn-del-source {
    background-color: #fee2e2 !important;
    color: #ef4444 !important;
    font-size: 24rpx !important;
    margin: 0 !important;
    padding: 4rpx 16rpx !important;
  }
  
  .add-source-bar {
    display: flex;
    gap: 12rpx;
    align-items: center;
  }
  
  .add-source-input {
    flex: 1;
  }
  
  .btn-add-source {
    background-color: #07c160 !important;
    color: #ffffff !important;
    font-size: 26rpx !important;
    height: 80rpx !important;
    line-height: 80rpx !important;
    padding: 0 30rpx !important;
    border-radius: 12rpx !important;
    margin: 0 !important;
    flex-shrink: 0;
  }
  
  .modal-title {
    font-size: 34rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    text-align: center;
  }
  
  .modal-desc {
    font-size: 28rpx;
    color: #666666;
    margin-bottom: 30rpx;
  }
  
  .modal-input {
    background: #f8fafc;
    border: 1rpx solid #e2e8f0;
    border-radius: 12rpx;
    padding: 0 24rpx;
    height: 80rpx;
    line-height: 80rpx;
    font-size: 28rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .btn-primary {
    background-color: #07c160;
    color: #ffffff;
    border-radius: 12rpx;
    font-size: 30rpx;
    padding: 20rpx 0;
    width: 100%;
    text-align: center;
  }
  
  .modal-btns {
    display: flex;
    gap: 20rpx;
    flex-shrink: 0;
  }
  
  .modal-btn {
    flex: 1;
    font-size: 28rpx;
    padding: 16rpx 0;
    border-radius: 12rpx;
    text-align: center;
    margin: 0 !important;
  }
  
  .modal-btn.cancel {
    background: #f1f5f9;
    color: #64748b;
  }
  
  .modal-btn.confirm {
    background: #07c160;
    color: #ffffff;
    font-weight: 500;
  }
  
  /* 底部悬浮条 */
  .batch-action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 110rpx;
    background: #ffffff;
    box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32rpx;
    box-sizing: border-box;
    z-index: 999;
  }
  
  .batch-info {
    font-size: 28rpx;
    color: #333333;
  }
  
  .batch-btns {
    display: flex;
    align-items: center;
    gap: 16rpx;
  }
  
  .btn-select-all {
    background-color: #f0f2f5;
    color: #666666;
    font-size: 24rpx;
    border-radius: 8rpx;
    padding: 10rpx 20rpx;
  }
  
  .btn-disabled {
    opacity: 0.5;
  }